#ifndef O_EXTENSIONS_HP

#include "cplus/cplus.h"
#define O_EXTENSIONS_HP

/* Modern C+ header: class with constructor and method, lowered from .hp. */
class Counter {
    int value;

    Counter(int start) {
        self->value = start;
    }

    void add(int n) {
        self->value += n;
    }

    int get(void) {
        return self->value;
    }
};

#endif
