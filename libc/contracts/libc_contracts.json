      "params": [
        "void *ptr",
        "size_t size"
      ],
      "nullableArgs": [
        0
      ],
      "ownership": "returns_owned",
      "transfer": "success-only old alias invalid",
      "extent": "size",
      "effects": [
        "allocates",
        "frees-on-success"
      ],
      "borrow": [],
      "failure": "returns NULL with errno EINVAL for a stale/unowned pointer, or ENOMEM on host OOM / injected failure; original block stays valid",
      "diagnostics": "CPLUS-SAFE-REALLOC",
      "dynamic": [
        "success-branch metadata update guarded by the original generation (ABA check in cplus_realloc, libc/src/stdlib/alloc.c)",
        "stale/unowned pointer returns NULL with errno EINVAL without freeing another block (meta_find_addr miss path in cplus_realloc)",
        "stale aliases are observable through cplus_alloc_check_generation, cplus_alloc_is_live and cplus_alloc_get_meta; a successful realloc and cplus_transfer_ownership bump the generation",
        "injected failure or host OOM returns NULL and preserves the original pointer, metadata and payload"
      ],
      "limitations": [
        "alias invalidation is heuristic, generation-based metadata invalidation, not a pointer-provenance or arbitrary-alias safety guarantee",
        "double/invalid-free classification uses a bounded 1024-entry open-addressed recent-free cache; when it fills, first-slot overwrite can misclassify a real double free as an invalid free",
        "passing a stale alias to host realloc after its address has been re-issued as a new live block is undefined behavior; the ABA guard protects metadata updates only, not the host realloc call",
        "cross-allocator use (host pointer passed to cplus_realloc, or cplus_malloc pointer passed to host free) is undefined behavior; it is refused with EINVAL only when the metadata check detects it"
      ],
      "evidence": {
        "source": [
          "libc/src/stdlib/alloc.c"
        ],
        "tests": [
          "tests/libc/test_alloc_metadata.c",
          "tests/libc/test_alloc_attack.c",
          "tests/safety/test_scenarios_c.c"
        ]
      },
      "paramTypes": [
        "void *ptr",
        "size_t size"
      ],
      "pointerBounds": "size",
      "allocationSize": "size",
      "ownershipTransfer": "success-only old alias invalid",
      "borrowLifetime": "n/a",
      "readEffects": [],
      "writeEffects": [],
      "freeEffects": [
        "frees-on-success"
      ],
      "returnState": "returns_owned",
      "failureBehavior": "returns NULL with errno EINVAL (stale/unowned pointer) or ENOMEM (OOM/injected failure); original block stays valid",
      "threadAssumptions": [
        "metadata table is mutex-protected; the host allocator call inside realloc is not serialized, so ABA generation checks protect bookkeeping only"
      ]
    },
