/* Bounded fork + SIGALRM watchdog for resource-exhaustion fixtures.
 *
 * No test in this suite is allowed to wait forever on a child.  The parent
 * arms a non-SA_RESTART SIGALRM backstop, so waitpid() is interrupted; on
 * expiry the child is SIGKILLed and reaped.  The exact wait status is kept so a
 * caller can distinguish "child exited 0", "child died from its own alarm" and
 * "parent watchdog had to kill it".  The previous SIGALRM disposition is
 * always restored before returning.
 *
 * The child gets SIGALRM reset to SIG_DFL and an optional self-alarm, which
 * makes a stuck child die deterministically instead of depending on the
 * parent's kill.  Both bounds are explicit counts (no division or modulo).
 */
#ifndef CPLUS_RE_WATCHDOG_HP
#define CPLUS_RE_WATCHDOG_HP

#include <errno.h>
#include <signal.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <unistd.h>

typedef void (*re_child_fn)(void);

struct re_watchdog_result {
    pid_t child_pid;
    int reaped;
    int timed_out;      /* parent backstop fired / SIGKILL was used */
    int exited;         /* WIFEXITED */
    int signaled;       /* WIFSIGNALED */
    int exit_code;      /* WEXITSTATUS when exited, else -1 */
    int term_signal;    /* WTERMSIG when signaled, else 0 */
    int raw_status;
};

static volatile sig_atomic_t re_watchdog_alarm_seen;

static void re_watchdog_on_alarm(int signo) {
    (void)signo;
    re_watchdog_alarm_seen = 1;
}

static inline void re_child_exit(int code) {
    _exit(code);
}

/* Run child_fn in a child under a hard parent alarm of hard_secs seconds.
 * child_alarm_secs == 0 disables the child's own alarm.
 */
static inline struct re_watchdog_result re_run_watchdog(re_child_fn child_fn,
                                                       unsigned int hard_secs,
                                                       int child_alarm_secs) {
    struct re_watchdog_result result;
    struct sigaction old_alarm_action;
    struct sigaction child_default;
    struct sigaction backstop;
    pid_t child_pid;
    pid_t wait_rc;
    int status;
    int reaped;
    int timed_out;

    result.child_pid = -1;
    result.reaped = 0;
    result.timed_out = 0;
    result.exited = 0;
    result.signaled = 0;
    result.exit_code = -1;
    result.term_signal = 0;
    result.raw_status = 0;
    status = 0;
    reaped = 0;
    timed_out = 0;

    if (child_fn == (re_child_fn)0 || hard_secs == 0)
        return result;

    child_pid = fork();
    if (child_pid == (pid_t)0) {
        memset(&child_default, 0, sizeof(child_default));
        child_default.sa_handler = SIG_DFL;
        sigemptyset(&child_default.sa_mask);
        child_default.sa_flags = 0;
        (void)!sigaction(SIGALRM, &child_default, (struct sigaction *)0);
        if (child_alarm_secs > 0)
            alarm((unsigned int)child_alarm_secs);
        child_fn();
        _exit(0);
    }
    if (child_pid < (pid_t)0)
        return result;

    result.child_pid = child_pid;

    memset(&backstop, 0, sizeof(backstop));
    backstop.sa_handler = re_watchdog_on_alarm;
    sigemptyset(&backstop.sa_mask);
    backstop.sa_flags = 0; /* deliberately not SA_RESTART: interrupt waitpid */
    if (sigaction(SIGALRM, &backstop, &old_alarm_action) != 0) {
        (void)!kill(child_pid, SIGKILL);
        while (waitpid(child_pid, &status, 0) < (pid_t)0) {
            /* bounded: SIGKILL cannot be caught */
        }
        result.reaped = 1;
        result.timed_out = 1;
        result.raw_status = status;
        return result;
    }

    re_watchdog_alarm_seen = 0;
    (void)!alarm(hard_secs);

    for (;;) {
        wait_rc = waitpid(child_pid, &status, 0);
        if (wait_rc == child_pid) {
            reaped = 1;
            break;
        }
        if (wait_rc < (pid_t)0 && errno == EINTR) {
            if (re_watchdog_alarm_seen) {
                timed_out = 1;
                break;
            }
            continue;
        }
        if (wait_rc < (pid_t)0)
            break;
    }

    (void)!alarm(0);
    (void)!sigaction(SIGALRM, &old_alarm_action, (struct sigaction *)0);

    if (!reaped) {
        timed_out = 1;
        (void)!kill(child_pid, SIGKILL);
        while (waitpid(child_pid, &status, 0) < (pid_t)0) {
            /* bounded: SIGKILL cannot be caught */
        }
        reaped = 1;
    }

    result.reaped = reaped;
    result.timed_out = timed_out;
    result.raw_status = status;
    if (WIFEXITED(status)) {
        result.exited = 1;
        result.exit_code = WEXITSTATUS(status);
    } else if (WIFSIGNALED(status)) {
        result.signaled = 1;
        result.term_signal = WTERMSIG(status);
    }
    return result;
}

#endif /* CPLUS_RE_WATCHDOG_HP */
