/* Shared helpers for native C+ test runners (no Python).
 *
 * Command execution goes through the hardened libc cplus_system() wrapper;
 * file I/O goes through stdlib/file.hp. Every helper is header-only so a
 * runner is a single self-contained .cp program compiled by build/c+.
 */
#ifndef CPLUS_TEST_NATIVE_HP
#define CPLUS_TEST_NATIVE_HP

#include <stddef.h>
#include <stdio.h>
#include <string.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"
#include "stdlib/file.hp"

extern int cplus_system(const char *cmd);

/* Run a command, redirecting stdout/stderr to files. Returns the shell rc. */
static inline int native_run_to(const char *cmd, const char *out, const char *err) {
    char buf[2048];
    int n = snprintf(buf, sizeof(buf), "{ %s ; } >\"%s\" 2>\"%s\"", cmd, out, err);
    if (n < 0 || (size_t)n >= sizeof(buf)) return 124;
    return cplus_system(buf);
}

/* Read a whole text file into buf (up to cap-1 bytes), NUL terminated.
 * Returns byte count, or -1 on failure. */
static inline long native_read(const char *path, char *buf, size_t cap) {
    error e = error();
    file f = file(path, "r");
    size_t total = 0;
    int st;
    if (!f.is_open()) return -1;
    for (;;) {
        size_t before = total;
        st = f.read(buf + total, cap - 1 - total, &e);
        if (st == STDLIB_EOF) break;
        if (st != STDLIB_OK) return -1;
        /* read() reports OK for a short read; EOF is reported on the next
         * call. Advance by the requested capacity only when bytes were
         * actually returned — strlen() is the safe proxy for text files. */
        total += strlen(buf + total);
        if (total == before || total >= cap - 1) break;
    }
    {
        char nul = '\0';
        __builtin_memcpy(buf + total, &nul, sizeof(nul));
    }
    return (long)total;
}

/* Write text to a file, truncating existing content. Returns 0 or -1. */
static inline int native_write(const char *path, const char *text) {
    error e = error();
    file f = file(path, "w");
    if (!f.is_open()) return -1;
    if (f.write_bytes(text, strlen(text), &e) != STDLIB_OK) return -1;
    return 0;
}

/* Append a JSON-escaped string to out (bounded). */
static inline void native_json_escape(const char *s, char *out, size_t cap) {
    size_t o = 0;
    while (*s != '\0' && o + 2 < cap) {
        unsigned char c = (unsigned char)*s++;
        if (c == '"' || c == '\\') {
            char bs = '\\';
            char ch = (char)c;
            __builtin_memcpy(out + o, &bs, sizeof(bs)); ++o;
            __builtin_memcpy(out + o, &ch, sizeof(ch)); ++o;
        } else if (c == '\n') {
            char bs = '\\';
            char esc = 'n';
            __builtin_memcpy(out + o, &bs, sizeof(bs)); ++o;
            __builtin_memcpy(out + o, &esc, sizeof(esc)); ++o;
        } else if (c == '\r') {
            char bs = '\\';
            char esc = 'r';
            __builtin_memcpy(out + o, &bs, sizeof(bs)); ++o;
            __builtin_memcpy(out + o, &esc, sizeof(esc)); ++o;
        } else if (c < 0x20) {
            o += (size_t)snprintf(out + o, cap - o, "\\u%04x", c);
        } else {
            char ch = (char)c;
            __builtin_memcpy(out + o, &ch, sizeof(ch)); ++o;
        }
    }
    {
        char nul = '\0';
        __builtin_memcpy(out + o, &nul, sizeof(nul));
    }
}

/* Count lines in a text buffer (for summaries). */
static inline int native_line_count(const char *text) {
    int n = 0;
    while (*text != '\0') {
        if (*text == '\n') ++n;
        ++text;
    }
    return n;
}

#endif
