{
  "schema": 1,
  "suite": "real_world_c",
  "description": "Unmodified, externally sourced single-file C programs built with c+ --legacy-c --sanitize=none and /usr/bin/clang, then compared on exact stdout and exit status. Generated C must equal the original modulo one leading #line directive.",
  "upstream": {
    "name": "TheAlgorithms/C",
    "url": "https://github.com/TheAlgorithms/C",
    "pinned_commit": "e5dad3fa8def3726ec850ca66a7f51521f8ad393",
    "raw_base": "https://raw.githubusercontent.com/TheAlgorithms/C/e5dad3fa8def3726ec850ca66a7f51521f8ad393",
    "license": "MIT (as found in the pinned tree; verify with LICENSE at the pin)",
    "download": "curl -fsSL --max-time <timeout> -o <dest> <url>"
  },
  "download_timeout_sec": 60,
  "build_timeout_sec": 180,
  "run_timeout_sec": 30,
  "mode": "--legacy-c",
  "sanitize": "none",
  "reference_cc": "/usr/bin/clang",
  "reference_flags": ["-std=gnu89", "-O2"],
  "cases": [
