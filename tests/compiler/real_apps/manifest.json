{
  "schema": 1,
  "suite": "real_apps",
  "description": "Pinned, unmodified real C applications and games downloaded at a full upstream commit and run through c+ LEGACY/DEFAULT/STRICT (--sanitize=none), clang -O2 and gcc-14 -O2 across -std=c89/c99/c11/c17. Every build, emitted-C byte comparison, exported-symbol comparison, stdout byte comparison and exit code is checked. No suppression, no silent skips.",
  "upstream": {
    "name": "TheAlgorithms/C",
    "url": "https://github.com/TheAlgorithms/C",
    "pinned_commit": "e5dad3fa8def3726ec850ca66a7f51521f8ad393",
    "raw_base": "https://raw.githubusercontent.com/TheAlgorithms/C/e5dad3fa8def3726ec850ca66a7f51521f8ad393",
    "license": "GPL-3.0-or-later (LICENSE at pinned commit: 'GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007'); local build/test only, no redistribution of upstream source in this repository",
    "license_url": "https://raw.githubusercontent.com/TheAlgorithms/C/e5dad3fa8def3726ec850ca66a7f51521f8ad393/LICENSE",
    "download": "curl -fsSL --max-time 45 -o <dest> <url>"
  },
  "standards": [
    "c89",
    "c99",
    "c11",
    "c17"
  ],
  "modes": [
    "--legacy-c",
    "--default",
    "--strict"
