/* Adversarial regression family: extremely long tokens and strings,
 * truncation detection, and stream alignment (agent 5).
 *
 * All input is generated deterministically in this program (no checked-in
 * fixtures, no user paths).  Tokens/streams are bounded at 4096 bytes, stored
 * in static arrays, and installed as `stdin` with fmemopen() for the duration
 * of one case; `stdin` is restored afterwards.  File-based line truncation is
 * exercised with a tmpfile() written by the test itself.  No memory
 * exhaustion and no allocation-failure injection.
 *
 * Every check prints "<tag> <0|1>".  The last line is
 * "ADV_LONG_INPUT <checks> <failures>"; exit status is 0 only on zero failures.
 * Locals use ali_/aib_ prefixes (C+ RAII lowering tracks owned names per
 * function).  No header or existing test is modified.
 */
#include <limits.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"
#include "stdlib/io.hp"
#include "stdlib/file.hp"

#define ALI_MAX 4096
#define ALI_SMALL 16
#define ALI_TOKBUF 64

static char ali_src[ALI_MAX + 32];
static char ali_small[ALI_SMALL];
static char ali_tok64[ALI_TOKBUF];
static char ali_huge[ALI_MAX];
static int ali_checks = 0;
static int ali_failures = 0;

static void ali_chk(const char *ali_tag, int ali_cond) {
    ali_checks++;
    if (!ali_cond)
        ali_failures++;
    print(ali_tag, ali_cond ? 1 : 0);
}

static void ali_fill(char *ali_buf, int ali_n, char ali_c) {
    int ali_i = 0;
    for (ali_i = 0; ali_i < ali_n; ali_i++)
        ali_buf[ali_i] = ali_c;
}

/* Install a generated byte buffer as stdin.  Caller restores stdin itself. */
static FILE *ali_open(int ali_len) {
    return fmemopen(ali_src, (size_t)ali_len, "r");
}

/* Copy a short literal into the generated buffer before installing it: this
 * keeps fmemopen's buffer non-const on every platform. */
static FILE *ali_open_text(const char *ali_text, int ali_len) {
    memcpy(ali_src, ali_text, (size_t)ali_len);
    return ali_open(ali_len);
}

/* ------------------------------------------------------------------ *
 * 1. 4096-byte numeric token into the small io.hp token buffer.
 * ------------------------------------------------------------------ */
static void ali_case_token_4096(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;
    int aib_v = 0;

    ali_fill(ali_src, ALI_MAX, '9');
    ali_src[ALI_MAX] = ' ';
    ali_src[ALI_MAX + 1] = '4';
    ali_src[ALI_MAX + 2] = '2';
    ali_src[ALI_MAX + 3] = '\n';

    stdin = ali_open(ALI_MAX + 4);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = stdlib_io_token(ali_small, sizeof(ali_small));
    ali_chk("ali_tok4096_truncated",
            aib_st == 2 && strlen(ali_small) == ALI_SMALL - 1 &&
                ali_small[0] == '9' && ali_small[ALI_SMALL - 2] == '9');
    aib_v = -1;
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_tok4096_aligned",
            aib_st == STDLIB_OK && aib_v == 42 &&
                ali_err->code() == CPLUS_EXIT_OK);
    fclose(stdin);
    stdin = ali_saved;
}

/* ------------------------------------------------------------------ *
 * 2. 4096-byte numeric token into read_int / read_long: rejected, the
 *    destination is untouched, and the next token is read exactly.
 * ------------------------------------------------------------------ */
static void ali_case_numeric_4096(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;
    int aib_iv = 0x12345678;
    long aib_lv = 0x1122334455667788L;

    ali_fill(ali_src, ALI_MAX, '8');
    ali_src[ALI_MAX] = ' ';
    ali_src[ALI_MAX + 1] = '7';
    ali_src[ALI_MAX + 2] = '\n';
    stdin = ali_open(ALI_MAX + 3);
    aib_st = read_int(&aib_iv, ali_err);
    ali_chk("ali_int4096_rejected",
            aib_st == STDLIB_FAIL && aib_iv == 0x12345678 &&
                ali_err->code() == CPLUS_EXIT_BOUNDS &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_iv = -1;
    aib_st = read_int(&aib_iv, ali_err);
    ali_chk("ali_int4096_aligned",
            aib_st == STDLIB_OK && aib_iv == 7 &&
                ali_err->code() == CPLUS_EXIT_OK);
    fclose(stdin);
    stdin = ali_saved;

    ali_fill(ali_src, ALI_MAX, '6');
    ali_src[ALI_MAX] = ' ';
    ali_src[ALI_MAX + 1] = '-';
    ali_src[ALI_MAX + 2] = '5';
    ali_src[ALI_MAX + 3] = '\n';
    stdin = ali_open(ALI_MAX + 4);
    aib_st = read_long(&aib_lv, ali_err);
    ali_chk("ali_long4096_rejected",
            aib_st == STDLIB_FAIL && aib_lv == 0x1122334455667788L &&
                ali_err->code() == CPLUS_EXIT_BOUNDS &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_lv = 0;
    aib_st = read_long(&aib_lv, ali_err);
    ali_chk("ali_long4096_aligned",
            aib_st == STDLIB_OK && aib_lv == -5 &&
                ali_err->code() == CPLUS_EXIT_OK);
    fclose(stdin);
    stdin = ali_saved;
}

/* ------------------------------------------------------------------ *
 * 3. Exact 63/64-byte boundary of the io.hp 64-byte token buffer.
 * ------------------------------------------------------------------ */
static void ali_case_token_boundary(void) {
    FILE *ali_saved = stdin;
    int aib_st = 0;

    ali_fill(ali_src, 63, '9');
    ali_src[63] = ' ';
    ali_src[64] = '1';
    ali_src[65] = '1';
    ali_src[66] = '\n';
    stdin = ali_open(67);
    memset(ali_tok64, 'Z', sizeof(ali_tok64));
    aib_st = stdlib_io_token(ali_tok64, sizeof(ali_tok64));
    ali_chk("ali_tok63_exact",
            aib_st == 0 && strlen(ali_tok64) == 63 &&
                ali_tok64[62] == '9' && ali_tok64[63] == '\0');
    fclose(stdin);
    stdin = ali_saved;

    ali_fill(ali_src, 64, '9');
    ali_src[64] = ' ';
    ali_src[65] = '1';
    ali_src[66] = '1';
    ali_src[67] = '\n';
    stdin = ali_open(68);
    memset(ali_tok64, 'Z', sizeof(ali_tok64));
    aib_st = stdlib_io_token(ali_tok64, sizeof(ali_tok64));
    ali_chk("ali_tok64_truncated",
            aib_st == 2 && strlen(ali_tok64) == 63 &&
                ali_tok64[62] == '9' && ali_tok64[63] == '\0');
    fclose(stdin);
    stdin = ali_saved;
}

/* ------------------------------------------------------------------ *
 * 4. A 4095-byte token fits a 4096-byte buffer exactly; one more byte
 *    truncates.  This bounds the generated-input path at both ends.
 * ------------------------------------------------------------------ */
static void ali_case_token_4095(void) {
    FILE *ali_saved = stdin;
    int aib_st = 0;

    ali_fill(ali_src, ALI_MAX - 1, 'z');
    ali_src[ALI_MAX - 1] = ' ';
    ali_src[ALI_MAX] = '3';
    ali_src[ALI_MAX + 1] = '\n';
    stdin = ali_open(ALI_MAX + 2);
    aib_st = stdlib_io_token(ali_huge, sizeof(ali_huge));
    ali_chk("ali_tok4095_exact",
            aib_st == 0 && strlen(ali_huge) == ALI_MAX - 1 &&
                ali_huge[ALI_MAX - 2] == 'z');
    ali_fill(ali_src, ALI_MAX, 'z');
    ali_src[ALI_MAX] = ' ';
    ali_src[ALI_MAX + 1] = '3';
    ali_src[ALI_MAX + 2] = '\n';
    fclose(stdin);
    stdin = ali_open(ALI_MAX + 3);
    aib_st = stdlib_io_token(ali_huge, sizeof(ali_huge));
    ali_chk("ali_tok4096_trunc_4kbuf",
            aib_st == 2 && strlen(ali_huge) == ALI_MAX - 1 &&
                ali_huge[ALI_MAX - 2] == 'z');
    fclose(stdin);
    stdin = ali_saved;
}

/* ------------------------------------------------------------------ *
 * 5. INT_MIN/INT_MAX accepted; one past either end rejected; valid
 *    input immediately after each rejection stays aligned.
 * ------------------------------------------------------------------ */
static void ali_case_int_limits(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;
    int aib_v = 0x0badf00d;

    stdin = ali_open_text("-2147483648 2147483647 2147483648 -2147483649 5\n",
                          48);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_int_min", aib_st == STDLIB_OK && aib_v == INT_MIN);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_int_max", aib_st == STDLIB_OK && aib_v == INT_MAX);
    aib_v = 0x0badf00d;
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_int_over",
            aib_st == STDLIB_FAIL && aib_v == 0x0badf00d &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_int_under",
            aib_st == STDLIB_FAIL && aib_v == 0x0badf00d &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_int_after_bad", aib_st == STDLIB_OK && aib_v == 5);
    fclose(stdin);
    stdin = ali_saved;
}

/* ------------------------------------------------------------------ *
 * 6. LONG_MIN/LONG_MAX and UINT64_MAX/SIZE_MAX decimal tokens into
 *    read_long: limits accepted, anything above LLONG_MAX rejected.
 * ------------------------------------------------------------------ */
static void ali_case_long_limits(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;
    long aib_v = 0x0badf00dL;

    stdin = ali_open_text("9223372036854775807 -9223372036854775808 "
                          "9223372036854775808 -9223372036854775809 9\n",
                          84);
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_long_max", aib_st == STDLIB_OK && aib_v == LONG_MAX);
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_long_min", aib_st == STDLIB_OK && aib_v == LONG_MIN);
    aib_v = 0x0badf00dL;
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_long_over",
            aib_st == STDLIB_FAIL && aib_v == 0x0badf00dL &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_long_under",
            aib_st == STDLIB_FAIL && aib_v == 0x0badf00dL &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_long_after_bad", aib_st == STDLIB_OK && aib_v == 9);
    fclose(stdin);
    stdin = ali_saved;

    stdin = ali_open_text("18446744073709551615 18446744073709551616 17\n",
                          45);
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_u64max_token_rejected",
            aib_st == STDLIB_FAIL &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_u64max_plus1_rejected",
            aib_st == STDLIB_FAIL &&
                ali_err->category() == STDLIB_CATEGORY_RANGE);
    aib_v = 0;
    aib_st = read_long(&aib_v, ali_err);
    ali_chk("ali_u64_after_bad", aib_st == STDLIB_OK && aib_v == 17);
    fclose(stdin);
    stdin = ali_saved;

    ali_chk("ali_size_equals_u64",
            sizeof(size_t) != 8 || (unsigned long long)SIZE_MAX == UINT64_MAX);
}

/* ------------------------------------------------------------------ *
 * 7. Repeated malformed tokens: fail, fail, ok, fail, ok.  The stream
 *    must stay aligned across every rejection.
 * ------------------------------------------------------------------ */
static void ali_case_repeated_malformed(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;
    int aib_v = 0x0badf00d;

    stdin = ali_open_text("abc 12x 13 - 14\n", 16);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_bad1",
            aib_st == STDLIB_FAIL && aib_v == 0x0badf00d &&
                ali_err->category() == STDLIB_CATEGORY_INVALID &&
                ali_err->code() == CPLUS_EXIT_UNSUPPORTED);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_bad2",
            aib_st == STDLIB_FAIL && aib_v == 0x0badf00d &&
                ali_err->category() == STDLIB_CATEGORY_INVALID);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_bad_then_ok", aib_st == STDLIB_OK && aib_v == 13);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_bad3",
            aib_st == STDLIB_FAIL && aib_v == 13 &&
                ali_err->category() == STDLIB_CATEGORY_INVALID);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_bad_final_ok", aib_st == STDLIB_OK && aib_v == 14);
    fclose(stdin);
    stdin = ali_saved;
}

/* ------------------------------------------------------------------ *
 * 8. A long *but valid* numeric token (leading zeros) must be accepted.
 * ------------------------------------------------------------------ */
static void ali_case_valid_long_token(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;
    int aib_v = 0;

    stdin = ali_open_text("00000000000000000007 3\n", 23);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_long_valid_token", aib_st == STDLIB_OK && aib_v == 7);
    aib_st = read_int(&aib_v, ali_err);
    ali_chk("ali_long_valid_aligned", aib_st == STDLIB_OK && aib_v == 3);
    fclose(stdin);
    stdin = ali_saved;
}

/* ------------------------------------------------------------------ *
 * 9. 4096-byte LINE truncation in io.hp::read_line and file::read_line.
 *    The remainder must be drained so the following record is readable.
 * ------------------------------------------------------------------ */
static void ali_case_line_truncation(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;

    ali_fill(ali_src, ALI_MAX, 'a');
    ali_src[ALI_MAX] = '\n';
    ali_src[ALI_MAX + 1] = 'n';
    ali_src[ALI_MAX + 2] = 'e';
    ali_src[ALI_MAX + 3] = 'x';
    ali_src[ALI_MAX + 4] = 't';
    ali_src[ALI_MAX + 5] = '\n';

    stdin = ali_open(ALI_MAX + 6);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = read_line(ali_small, sizeof(ali_small), ali_err);
    ali_chk("ali_line4096_truncated",
            aib_st == STDLIB_FAIL && ali_small[0] == '\0' &&
                ali_err->code() == CPLUS_EXIT_BOUNDS &&
                ali_err->category() == STDLIB_CATEGORY_BOUNDS);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = read_line(ali_small, sizeof(ali_small), ali_err);
    ali_chk("ali_line4096_aligned",
            aib_st == STDLIB_OK && strcmp(ali_small, "next") == 0 &&
                ali_err->code() == CPLUS_EXIT_OK);
    fclose(stdin);
    stdin = ali_saved;

    /* Cross-reader alignment: a rejected line must not disturb a token read. */
    ali_fill(ali_src, ALI_MAX, 'b');
    ali_src[ALI_MAX] = '\n';
    ali_src[ALI_MAX + 1] = '4';
    ali_src[ALI_MAX + 2] = '2';
    ali_src[ALI_MAX + 3] = '\n';
    stdin = ali_open(ALI_MAX + 4);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = read_line(ali_small, sizeof(ali_small), ali_err);
    {
        int aib_v = 0;
        int aib_line_bad = aib_st == STDLIB_FAIL && ali_small[0] == '\0';
        aib_st = read_int(&aib_v, ali_err);
        ali_chk("ali_line_to_token_aligned",
                aib_line_bad && aib_st == STDLIB_OK && aib_v == 42);
    }
    fclose(stdin);
    stdin = ali_saved;

    /* Same truncation through the RAII file wrapper over a generated file.
     * Regenerate the fixture: the cross-reader case above reused ali_src. */
    ali_fill(ali_src, ALI_MAX, 'a');
    ali_src[ALI_MAX] = '\n';
    ali_src[ALI_MAX + 1] = 'n';
    ali_src[ALI_MAX + 2] = 'e';
    ali_src[ALI_MAX + 3] = 'x';
    ali_src[ALI_MAX + 4] = 't';
    ali_src[ALI_MAX + 5] = '\n';
    {
        file ali_f = file_temp(ali_err);
        int aib_line_bad = 0;
        if (ali_f.is_open()) {
            ali_f.write_bytes(ali_src, (size_t)(ALI_MAX + 6), ali_err);
            ali_f.seek(0L, SEEK_SET, ali_err);
            memset(ali_small, 'Z', sizeof(ali_small));
            aib_st = ali_f.read_line(ali_small, sizeof(ali_small), ali_err);
            aib_line_bad = aib_st == STDLIB_FAIL && ali_small[0] == '\0' &&
                           ali_err->code() == CPLUS_EXIT_BOUNDS &&
                           ali_err->category() == STDLIB_CATEGORY_BOUNDS;
            memset(ali_small, 'Z', sizeof(ali_small));
            aib_st = ali_f.read_line(ali_small, sizeof(ali_small), ali_err);
            ali_chk("ali_file_line_truncated", aib_line_bad);
            ali_chk("ali_file_line_aligned",
                    aib_st == STDLIB_OK && strcmp(ali_small, "next") == 0 &&
                        ali_err->code() == CPLUS_EXIT_OK);
        } else {
            ali_chk("ali_file_line_truncated", 0);
            ali_chk("ali_file_line_aligned", 0);
        }
    }
}

/* ------------------------------------------------------------------ *
 * 10. Truncation at physical EOF (no delimiter at all): the reader must
 *     report truncation (or EOF) and never loop or overrun the buffer.
 * ------------------------------------------------------------------ */
static void ali_case_eof_truncation(error *ali_err) {
    FILE *ali_saved = stdin;
    int aib_st = 0;

    ali_fill(ali_src, ALI_MAX, 'x');
    stdin = ali_open(ALI_MAX);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = stdlib_io_token(ali_small, sizeof(ali_small));
    ali_chk("ali_token_eof_truncated",
            aib_st == 2 && strlen(ali_small) == ALI_SMALL - 1);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = stdlib_io_token(ali_small, sizeof(ali_small));
    ali_chk("ali_token_eof_next", aib_st == 1 && ali_small[0] == 'Z');
    fclose(stdin);
    stdin = ali_saved;

    ali_fill(ali_src, ALI_MAX, 'y');
    stdin = ali_open(ALI_MAX);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = read_line(ali_small, sizeof(ali_small), ali_err);
    ali_chk("ali_line_eof_truncated",
            aib_st == STDLIB_FAIL && ali_small[0] == '\0' &&
                ali_err->category() == STDLIB_CATEGORY_BOUNDS);
    memset(ali_small, 'Z', sizeof(ali_small));
    aib_st = read_line(ali_small, sizeof(ali_small), ali_err);
    ali_chk("ali_line_eof_next",
            aib_st == STDLIB_EOF && ali_small[0] == 'Z' &&
                ali_err->code() == CPLUS_EXIT_OK);
    fclose(stdin);
    stdin = ali_saved;
}

int main(void) {
    error ali_err = error();
    stdlib_set_error_callback(NULL);

    ali_case_token_4096(&ali_err);
    ali_case_numeric_4096(&ali_err);
    ali_case_token_boundary();
    ali_case_token_4095();
    ali_case_int_limits(&ali_err);
    ali_case_long_limits(&ali_err);
    ali_case_repeated_malformed(&ali_err);
    ali_case_valid_long_token(&ali_err);
    ali_case_line_truncation(&ali_err);
    ali_case_eof_truncation(&ali_err);

    print("ADV_LONG_INPUT", ali_checks, ali_failures);
    return ali_failures == 0 ? 0 : 1;
}
