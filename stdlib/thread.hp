/* C+ standard library: RAII mutex and lock guard over POSIX threads.
 *
 * C++-flavoured: `mutex m = mutex(); { guard g = guard(&m); ... }` locks for
 * the scope and releases in drop().  A zero-initialised mutex or guard has no
 * handle or owner, so its destructor is a no-op rather than a stray unlock.
 *
 * Inside a class body C+ only rewrites `this->method()` calls, so internal
 * cross-object calls use the lowered names (`mutex_lock`, ...).
 */
#ifndef CPLUS_STD_THREAD_HP
#define CPLUS_STD_THREAD_HP

#include "cplus/cplus.h"

class mutex {
    void *handle;

    mutex(void) {
        this->handle = cplus_mutex_new();
    }

    int is_valid(void) {
        return this->handle != NULL;
    }

    void lock(void) {
        if (this->handle != NULL)
            cplus_mutex_lock(this->handle);
    }

    void unlock(void) {
        if (this->handle != NULL)
            cplus_mutex_unlock(this->handle);
    }

    void *native(void) {
        return this->handle;
    }

    void drop(void) {
        if (this->handle != NULL) {
            cplus_mutex_free(this->handle);
            this->handle = NULL;
        }
    }
};

/* Borrowed lock guard: it never owns the mutex, only the critical section. */
class guard {
    mutex *owner;

    guard(mutex *owner) {
        this->owner = owner;
        if (owner != NULL)
            mutex_lock(owner);
    }

    int holds(void) {
        return this->owner != NULL;
    }

    void unlock(void) {
        if (this->owner != NULL)
            mutex_unlock(this->owner);
    }

    void drop(void) {
        if (this->owner != NULL)
            mutex_unlock(this->owner);
        this->owner = NULL;
    }
};

#endif
