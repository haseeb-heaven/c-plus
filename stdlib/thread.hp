/* C+ standard library: RAII mutex and lock guard over POSIX threads.
 *
 * Mutex owns a runtime mutex handle; Guard borrows a Mutex and releases it in
 * drop().  A zero-initialised Mutex or Guard has a NULL handle/owner, so its
 * destructor is a no-op rather than a stray unlock.
 */
#ifndef CPLUS_STD_THREAD_HP
#define CPLUS_STD_THREAD_HP

#include "cplus/cplus.h"

resource struct Mutex {
    void *handle;
};

static inline void Mutex_drop(Mutex *self) {
    if (self->handle != NULL) {
        cplus_mutex_free(self->handle);
        self->handle = NULL;
    }
}

static inline Mutex Mutex_new(void) {
    Mutex mutex;
    mutex.handle = cplus_mutex_new();
    return mutex;
}

static inline int Mutex_valid(const Mutex *self) {
    return self->handle != NULL;
}

/* Borrowed lock guard: it never owns the mutex, only the critical section. */
resource struct Guard {
    Mutex *owner;
};

static inline void Guard_drop(Guard *self) {
    if (self->owner != NULL && self->owner->handle != NULL)
        cplus_mutex_unlock(self->owner->handle);
    self->owner = NULL;
}

static inline Guard Guard_lock(Mutex *mutex) {
    Guard guard;
    guard.owner = mutex;
    if (mutex != NULL && mutex->handle != NULL)
        cplus_mutex_lock(mutex->handle);
    return guard;
}

static inline int Guard_holds(const Guard *self) {
    return self->owner != NULL;
}

#endif
