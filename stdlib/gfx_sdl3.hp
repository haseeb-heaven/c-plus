/* C+ modern GFX/GUI facade over SDL3 (zlib, system-installed, real windowed
 * rendering).  Additive header; no upstream source edited.  Widgets are drawn
 * into a real SDL3 renderer, producing a real framebuffer, not CLI transcripts.
 *
 * SDL init/quit is reference counted across windows (#79): closing one window
 * never tears down SDL for the others, and partial open failures are cleaned
 * up before returning.  All handles are idempotent and NULL-safe.
 */
#ifndef CPLUS_STD_GFX_SDL3_HP
#define CPLUS_STD_GFX_SDL3_HP

#include <SDL3/SDL.h>

/* One shared count per program (weak, like stdlib_state in error.hp). */
__attribute__((weak)) int cplus_gfx_sdl3_refcount;

/* Returns 1 when SDL is retained, 0 when SDL_Init() refused the subsystem. */
static inline int cplus_gfx_sdl3_retain(void) {
    int previous = __atomic_fetch_add(&cplus_gfx_sdl3_refcount, 1,
                                      __ATOMIC_ACQ_REL);
    if (previous == 0 && !SDL_Init(SDL_INIT_VIDEO)) {
        (void)__atomic_fetch_sub(&cplus_gfx_sdl3_refcount, 1,
                                 __ATOMIC_ACQ_REL);
        return 0;
    }
    return 1;
}

static inline void cplus_gfx_sdl3_release(void) {
    if (__atomic_fetch_sub(&cplus_gfx_sdl3_refcount, 1,
                           __ATOMIC_ACQ_REL) == 1)
        SDL_Quit();
}

typedef struct {
    SDL_Window *window;
    SDL_Renderer *renderer;
    int sdl_ref;                   /* 1 while this window holds an SDL ref */
} cplus_gfx_window;

static inline void cplus_gfx_close(cplus_gfx_window *g);

static inline int cplus_gfx_open(cplus_gfx_window *g, const char *title,
                                 int w, int h) {
    if (g == (cplus_gfx_window *)0) return 0;
    g->window = (SDL_Window *)0;
    g->renderer = (SDL_Renderer *)0;
    g->sdl_ref = 0;
    if (!cplus_gfx_sdl3_retain()) return 0;
    g->sdl_ref = 1;
    g->window = SDL_CreateWindow(title, w, h, 0u);
    if (g->window == (SDL_Window *)0) {
        cplus_gfx_close(g);
        return 0;
    }
    g->renderer = SDL_CreateRenderer(g->window, (const char *)0);
    if (g->renderer == (SDL_Renderer *)0) {
        cplus_gfx_close(g);        /* destroys window, releases SDL ref */
        return 0;
    }
    return 1;
}

/* NULL-safe and idempotent: destroying twice or closing NULL is a no-op. */
static inline void cplus_gfx_close(cplus_gfx_window *g) {
    if (g == (cplus_gfx_window *)0) return;
    if (g->renderer != (SDL_Renderer *)0) {
        SDL_DestroyRenderer(g->renderer);
        g->renderer = (SDL_Renderer *)0;
    }
    if (g->window != (SDL_Window *)0) {
        SDL_DestroyWindow(g->window);
        g->window = (SDL_Window *)0;
    }
    if (g->sdl_ref != 0) {
        g->sdl_ref = 0;
        cplus_gfx_sdl3_release();  /* SDL_Quit only for the last window */
    }
}

static inline int cplus_gfx_ready(const cplus_gfx_window *g) {
    return g != (cplus_gfx_window *)0 && g->renderer != (SDL_Renderer *)0;
}

static inline void cplus_gfx_clear(cplus_gfx_window *g, unsigned char r,
                                   unsigned char gg, unsigned char b) {
    if (!cplus_gfx_ready(g)) return;
    SDL_SetRenderDrawColor(g->renderer, r, gg, b, 255);
    SDL_RenderClear(g->renderer);
}

static inline void cplus_gfx_rect(cplus_gfx_window *g, int x, int y,
                                  int w, int h, unsigned char r,
                                  unsigned char gg, unsigned char b) {
    SDL_FRect rect;
    if (!cplus_gfx_ready(g)) return;
    rect.x = (float)x; rect.y = (float)y;
    rect.w = (float)w; rect.h = (float)h;
    SDL_SetRenderDrawColor(g->renderer, r, gg, b, 255);
    SDL_RenderFillRect(g->renderer, &rect);
}

static inline void cplus_gfx_text(cplus_gfx_window *g, int x, int y,
                                  const char *text) {
    if (!cplus_gfx_ready(g) || text == (const char *)0) return;
    SDL_RenderDebugText(g->renderer, (float)x, (float)y, text);
}

static inline void cplus_gfx_textbox(cplus_gfx_window *g, int x, int y,
                                     int w, const char *label,
                                     const char *value) {
    if (!cplus_gfx_ready(g)) return;
    cplus_gfx_rect(g, x, y, w, 28, 30, 40, 55);
    cplus_gfx_rect(g, x + 1, y + 1, w - 2, 26, 13, 17, 23);
    cplus_gfx_text(g, x + 8, y + 6, label);
    cplus_gfx_text(g, x + 70, y + 6, value);
}

static inline void cplus_gfx_dropdown(cplus_gfx_window *g, int x, int y,
                                      int w, const char *label,
                                      const char *selected) {
    if (!cplus_gfx_ready(g)) return;
    cplus_gfx_rect(g, x, y, w, 28, 45, 60, 80);
    cplus_gfx_text(g, x + 8, y + 6, label);
    cplus_gfx_text(g, x + 100, y + 6, selected);
    cplus_gfx_rect(g, x + w - 24, y + 8, 10, 10, 90, 200, 250);
}

static inline void cplus_gfx_list(cplus_gfx_window *g, int x, int y, int w,
                                  int rows, const char *const *items,
                                  int selected) {
    int i;
    if (!cplus_gfx_ready(g) || rows <= 0 ||
        items == (const char *const *)0) return;
    for (i = 0; i < rows; ++i) {
        cplus_gfx_rect(g, x, y + i * 28, w, 26,
                       i == selected ? 38 : 20,
                       i == selected ? 100 : 30,
                       i == selected ? 160 : 45);
        if (items[i] != (const char *)0)
            cplus_gfx_text(g, x + 8, y + i * 28 + 6, items[i]);
    }
}

static inline void cplus_gfx_button(cplus_gfx_window *g, int x, int y,
                                    int w, const char *label) {
    if (!cplus_gfx_ready(g)) return;
    cplus_gfx_rect(g, x, y, w, 30, 63, 130, 200);
    cplus_gfx_text(g, x + 10, y + 8, label);
}

static inline void cplus_gfx_present(cplus_gfx_window *g) {
    if (!cplus_gfx_ready(g)) return;
    SDL_RenderPresent(g->renderer);
}

#endif /* CPLUS_STD_GFX_SDL3_HP */
