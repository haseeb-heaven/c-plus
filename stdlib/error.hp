/* C+ standard library: recoverable errors.
 *
 * C++-flavoured surface without C++ exceptions: an `error` value carries a
 * status code and a message, and library calls report through it.  Nothing in
 * this header terminates the process; fatal safety violations stay the
 * runtime's job (cplus_fatal).
 *
 * `error_reset` / `error_fail` are free helpers as well as being what the
 * methods call, so they also work inside class methods, where method-call
 * sugar on parameters is not applied.
 */
#ifndef CPLUS_STD_ERROR_HP
#define CPLUS_STD_ERROR_HP

#include "cplus/cplus.h"

#define STDLIB_OK 0    /* success                     */
#define STDLIB_EOF 1   /* end of input, not a failure */
#define STDLIB_FAIL -1 /* failure; see the error      */

#define STDLIB_ERROR_SIZE 256

static inline void error_reset(void *target);
static inline void error_fail(void *target, cplus_exit_code code,
                              const char *message);

class error {
    int failed;
    cplus_exit_code status;
    char text[STDLIB_ERROR_SIZE];

    error(void) {
        this->failed = 0;
        this->status = CPLUS_EXIT_OK;
        this->text[0] = '\0';
    }

    int ok(void) {
        return !this->failed;
    }

    int failed_now(void) {
        return this->failed;
    }

    int code(void) {
        return (int)this->status;
    }

    const char *what(void) {
        return this->text;
    }

    void clear(void) {
        error_reset(this);
    }

    void set(cplus_exit_code code_value, const char *message) {
        error_fail(this, code_value, message);
    }
};

static inline void error_reset(void *target) {
    error *slot = (error *)target;
    if (slot == NULL)
        return;
    slot->failed = 0;
    slot->status = CPLUS_EXIT_OK;
    slot->text[0] = '\0';
}

static inline void error_fail(void *target, cplus_exit_code code,
                              const char *message) {
    error *slot = (error *)target;
    size_t i = 0;
    if (slot == NULL)
        return;
    slot->failed = 1;
    slot->status = code;
    if (message != NULL) {
        while (message[i] != '\0' && i + 1 < STDLIB_ERROR_SIZE) {
            slot->text[i] = message[i];
            i++;
        }
    }
    slot->text[i] = '\0';
}

#endif
