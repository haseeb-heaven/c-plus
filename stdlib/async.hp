/* C+ standard library: event loop, timers and file I/O via libuv (MIT, linked).
 *
 * C++-flavoured RAII: `loop l = loop(&err); timer t = timer(l.native(),
 * &err);` and both release in drop().  libuv stays the event engine.
 * Link with pkg-config libuv.
 */
#ifndef CPLUS_STD_ASYNC_HP
#define CPLUS_STD_ASYNC_HP

#include <fcntl.h>
#include <limits.h>
#include <stdint.h>
#include <stdlib.h>
#include <uv.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"

/* HARDENING (thread2): libuv's uv_run() accepts only UV_RUN_DEFAULT,
 * UV_RUN_ONCE or UV_RUN_NOWAIT.  Any other int cast to uv_run_mode is silently
 * treated as a no-op that returns 0, so an unvalidated loop::run() reported
 * STDLIB_OK with a clear error even though no work happened.  This fail-closed
 * predicate is a header-only static helper: no signature, struct layout or
 * exported symbol changes. */
static inline int stdlib_uv_run_mode_valid(int mode) {
    return mode == (int)UV_RUN_DEFAULT || mode == (int)UV_RUN_ONCE ||
           mode == (int)UV_RUN_NOWAIT;
}

/* HARDENING (#60): a timer must never touch a loop that has already been
 * dropped.  The loop owns a heap lifetime token, published through the loop's
 * `data` field; timers retain it while alive.  Once the token is marked dead
 * all timer operations fail closed without dereferencing the native loop. */
#define STDLIB_LOOP_LIFETIME_MAGIC ((uint64_t)0x43504C4F4F503031ULL)

typedef struct stdlib_loop_lifetime {
    uint64_t magic;
    uv_loop_t *native;
    int alive;
    int refs;                  /* one for the loop, one per live timer */
} stdlib_loop_lifetime;

static inline stdlib_loop_lifetime *stdlib_loop_lifetime_get(uv_loop_t *native) {
    stdlib_loop_lifetime *token;
    if (native == (uv_loop_t *)0) return (stdlib_loop_lifetime *)0;
    token = (stdlib_loop_lifetime *)native->data;
    if (token == (stdlib_loop_lifetime *)0 ||
        token->magic != STDLIB_LOOP_LIFETIME_MAGIC ||
        token->native != native || token->alive == 0)
        return (stdlib_loop_lifetime *)0;
    return token;
}

static inline void stdlib_loop_lifetime_retain(stdlib_loop_lifetime *token) {
    if (token != (stdlib_loop_lifetime *)0)
        (void)__atomic_fetch_add(&token->refs, 1, __ATOMIC_ACQ_REL);
}

static inline void stdlib_loop_lifetime_release(stdlib_loop_lifetime *token) {
    if (token != (stdlib_loop_lifetime *)0 &&
        __atomic_fetch_sub(&token->refs, 1, __ATOMIC_ACQ_REL) == 1)
        stdlib_release(token);
}

class loop {
    uv_loop_t native_loop;
    int initialized;
    stdlib_loop_lifetime *lifetime;

    loop(error *err) {
        do {
            error_reset(err);
            this->initialized = 0;
            this->lifetime = (stdlib_loop_lifetime *)0;
            if (uv_loop_init(&this->native_loop) != 0) {
                error_fail(err, CPLUS_EXIT_RESOURCE, "loop: uv_loop_init failed");
                break;
            }
            this->lifetime = (stdlib_loop_lifetime *)
                stdlib_alloc(sizeof(stdlib_loop_lifetime));
            if (this->lifetime == (stdlib_loop_lifetime *)0) {
                (void)uv_loop_close(&this->native_loop);
                error_fail(err, CPLUS_EXIT_RESOURCE,
                           "loop: lifetime token allocation failed");
                break;
            }
            this->lifetime->magic = STDLIB_LOOP_LIFETIME_MAGIC;
            this->lifetime->native = &this->native_loop;
            this->lifetime->alive = 1;
            this->lifetime->refs = 1;
            this->native_loop.data = this->lifetime;
            this->initialized = 1;
        } while (0);
    }

    int valid(void) {
        return this->initialized != 0;
    }

    /* Borrowed native loop for APIs that need the libuv type. */
    uv_loop_t *native(void) {
        return &this->native_loop;
    }

    int run(int mode, error *err) {
        error_reset(err);
        if (!this->valid()) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "loop::run: invalid loop");
            return STDLIB_FAIL;
        }
        if (!stdlib_uv_run_mode_valid(mode)) {
            error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                           "loop::run: invalid uv_run mode");
            return STDLIB_FAIL;
        }
        if (uv_run(&this->native_loop, (uv_run_mode)mode) != 0)
            cplus_log(CPLUS_LOG_DEBUG, "loop::run: active handles remain");
        return STDLIB_OK;
    }

    void stop(void) {
        if (this->valid())
            uv_stop(&this->native_loop);
    }

    unsigned long long now_ms(void) {
        if (!this->valid())
            return 0;
        return (unsigned long long)uv_now(&this->native_loop);
    }

    /* Drains pending closes (bounded) before releasing the loop memory: a
     * handle whose uv_close() has not completed would otherwise point at freed
     * memory. */
    void drop(void) {
        int guard = 0;
        if (!this->initialized)
            return;
        while (uv_loop_alive(&this->native_loop) && guard < 1000) {
            uv_run(&this->native_loop, UV_RUN_NOWAIT);
            guard++;
        }
        /* HARDENING (thread2): uv_loop_close() fails with UV_EBUSY when a
         * handle is still active.  The old code cleared `initialized` on that
         * failure, which lied to valid() and made every later drop() a no-op,
         * so the native loop could never be retried or released.  Stay
         * initialized until the close actually succeeds: a later explicit
         * drop() (and the compiler-emitted drop at scope exit) then retries
         * the bounded drain instead of silently leaking the loop. */
        /* (#60) Kill the lifetime token before releasing the native loop: a
         * timer that outlives this loop must fail closed instead of re-entering
         * closed libuv memory. */
        if (this->lifetime != (stdlib_loop_lifetime *)0) {
            this->lifetime->alive = 0;
            this->native_loop.data = (void *)0;
            stdlib_loop_lifetime_release(this->lifetime);
            this->lifetime = (stdlib_loop_lifetime *)0;
        }
        if (uv_loop_close(&this->native_loop) != 0) {
            cplus_log(CPLUS_LOG_WARN, "loop::drop: libuv loop still busy");
            return; /* keep initialized == 1 so a later drop() can retry */
        }
        this->initialized = 0;
    }
};

/* uv_close() is asynchronous: the handle memory must outlive the close. */
static inline void stdlib_timer_release_handle(uv_handle_t *handle) {
    stdlib_release(handle);
}

class timer {
    uv_timer_t *handle;
    uv_loop_t *owner_loop;
    stdlib_loop_lifetime *lifetime;
    int initialized;

    /* Takes the native loop: a constructor must not use `->`. */
    timer(uv_loop_t *owner_loop, error *err) {
        error_reset(err);
        this->handle = NULL;
        this->owner_loop = NULL;
        this->lifetime = (stdlib_loop_lifetime *)0;
        this->initialized = 0;
        this->lifetime = stdlib_loop_lifetime_get(owner_loop);
        if (this->lifetime == (stdlib_loop_lifetime *)0) {
            error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                           "timer: invalid or dropped loop");
        } else {
            this->handle = (uv_timer_t *)stdlib_alloc(sizeof(uv_timer_t));
            if (this->handle == NULL) {
                this->lifetime = (stdlib_loop_lifetime *)0;
                error_fail_cat(err, STDLIB_CATEGORY_MEMORY, CPLUS_EXIT_RESOURCE,
                               "timer: out of memory");
            } else if (uv_timer_init(owner_loop, this->handle) != 0) {
                stdlib_release(this->handle);
                this->handle = NULL;
                this->lifetime = (stdlib_loop_lifetime *)0;
                error_fail_cat(err, STDLIB_CATEGORY_MEMORY, CPLUS_EXIT_RESOURCE,
                               "timer: uv_timer_init failed");
            } else {
                stdlib_loop_lifetime_retain(this->lifetime);
                this->owner_loop = owner_loop;
                this->initialized = 1;
            }
        }
    }

    int valid(void) {
        return this->initialized != 0 && this->handle != NULL &&
               this->lifetime != (stdlib_loop_lifetime *)0 &&
               this->lifetime->alive != 0;
    }

    /* repeat_ms of 0 fires once; user is reachable as handle->data. */
    int start(uv_timer_cb callback, unsigned long long timeout_ms,
              unsigned long long repeat_ms, void *user, error *err) {
        error_reset(err);
        if (!this->valid() || callback == NULL) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "timer::start: invalid timer");
            return STDLIB_FAIL;
        }
        this->handle->data = user;
        if (uv_timer_start(this->handle, callback, timeout_ms, repeat_ms) != 0) {
            error_fail(err, CPLUS_EXIT_IO, "timer::start: uv_timer_start failed");
            return STDLIB_FAIL;
        }
        return STDLIB_OK;
    }

    int stop(error *err) {
        error_reset(err);
        if (!this->valid()) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "timer::stop: invalid timer");
            return STDLIB_FAIL;
        }
        if (uv_timer_stop(this->handle) != 0) {
            error_fail(err, CPLUS_EXIT_IO, "timer::stop: uv_timer_stop failed");
            return STDLIB_FAIL;
        }
        return STDLIB_OK;
    }

    int is_active(void) {
        if (!this->valid())
            return 0;
        return uv_is_active((const uv_handle_t *)this->handle) ? 1 : 0;
    }

    /* The handle lives on the heap and is released by uv_close's callback;
     * loop::drop() drains pending closes.  Never call uv_run() here: dropping a
     * timer from inside its own callback would recurse into the running loop
     * (#60), and a dropped loop must never be dereferenced. */
    void drop(void) {
        if (!this->initialized)
            return;
        if (this->handle != NULL) {
            if (this->lifetime != (stdlib_loop_lifetime *)0 &&
                this->lifetime->alive != 0) {
                uv_timer_stop(this->handle);
                this->handle->data = NULL;
                uv_close((uv_handle_t *)this->handle,
                         stdlib_timer_release_handle);
            } else {
                /* The loop already closed: libuv no longer holds the handle. */
                stdlib_release(this->handle);
            }
            this->handle = NULL;
        }
        stdlib_loop_lifetime_release(this->lifetime);
        this->lifetime = (stdlib_loop_lifetime *)0;
        this->owner_loop = NULL;
        this->initialized = 0;
    }
};

/* Reads at most size bytes of path into the caller's buffer; byte count or -1. */
static inline long long read_file(loop *owner, const char *path, char *buf,
                                  size_t size, error *err) {
    uv_fs_t req;
    uv_buf_t chunk;
    uv_file fd;
    long long read = -1;
    error_reset(err);
    if (owner == NULL || !owner->valid() || path == NULL || buf == NULL ||
        size == 0) {
        error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                       "read_file: invalid argument");
        return -1;
    }
    if (size > (size_t)UINT_MAX) {
        error_fail_cat(err, STDLIB_CATEGORY_BOUNDS, CPLUS_EXIT_BOUNDS,
                       "read_file: buffer size exceeds UINT_MAX");
        return -1;
    }
    fd = uv_fs_open(&owner->native_loop, &req, path, O_RDONLY, 0, NULL);
    if (fd < 0) {
        error_fail(err, CPLUS_EXIT_IO, uv_strerror((int)fd));
        uv_fs_req_cleanup(&req);
        return -1;
    }
    uv_fs_req_cleanup(&req);
    chunk = uv_buf_init(buf, (unsigned int)size);
    read = (long long)uv_fs_read(&owner->native_loop, &req, fd, &chunk, 1, -1, NULL);
    if (read < 0) {
        error_fail(err, CPLUS_EXIT_IO, uv_strerror((int)read));
        read = -1;
    }
    uv_fs_req_cleanup(&req);
    uv_fs_close(&owner->native_loop, &req, fd, NULL);
    uv_fs_req_cleanup(&req);
    return read;
}

static inline void sleep_ms(unsigned ms) {
    uv_sleep(ms);
}

static inline const char *uv_error_text(int status) {
    return uv_strerror(status);
}

#endif
