/* C+ standard library: convenience I/O and safe interactive input.
 *
 * print()/scan() come from the runtime; this header adds the recoverable,
 * bounded readers.  Conversion is delegated to libc (strtol, strtoll, strtof,
 * strtod) - there is no hand-written number parser here.
 *
 * Every reader returns STDLIB_OK, STDLIB_EOF or STDLIB_FAIL and fills the
 * error argument (cleared on success).
 */
#ifndef CPLUS_STD_IO_HP
#define CPLUS_STD_IO_HP

#include <ctype.h>
#include <errno.h>
#include <limits.h>
#include <math.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"

static inline void println(void) {
    print();
}

/* Read one whitespace-delimited token into buf (always NUL-terminated).
 * Returns 0 on success, 1 at end of input.  Reads at most size-1 bytes. */
static inline int stdlib_io_token(char *buf, size_t size) {
    int c;
    size_t stored = 0;
    do {
        c = fgetc(stdin);
    } while (c != EOF && isspace((unsigned char)c));
    if (c == EOF)
        return 1;
    while (c != EOF && !isspace((unsigned char)c)) {
        if (stored + 1 < size)
            buf[stored++] = (char)c;
        c = fgetc(stdin);
    }
    buf[stored] = '\0';
    return 0;
}

static inline int read_line(char *buf, size_t size, error *err) {
    error_reset(err);
    if (buf == NULL || size == 0) {
        error_fail(err, CPLUS_EXIT_IO, "read_line: destination is null or empty");
        return STDLIB_FAIL;
    }
    if (fgets(buf, (int)size, stdin) == NULL) {
        if (feof(stdin))
            return STDLIB_EOF;
        error_fail(err, CPLUS_EXIT_IO, "read_line: input stream error");
        return STDLIB_FAIL;
    }
    {
        size_t n = strlen(buf);
        /* No hidden truncation: a full buffer with no newline and no EOF means
         * the line did not fit.  Drain the remainder so the stream stays
         * aligned, then report it. */
        if (n == size - 1 && buf[n - 1] != '\n' && buf[n - 1] != '\r' &&
            !feof(stdin)) {
            int c;
            do {
                c = fgetc(stdin);
            } while (c != EOF && c != '\n');
            error_fail_cat(err, STDLIB_CATEGORY_BOUNDS, CPLUS_EXIT_BOUNDS,
                           "read_line: line longer than the buffer");
            buf[0] = '\0';
            return STDLIB_FAIL;
        }
        while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r'))
            buf[--n] = '\0';
    }
    return STDLIB_OK;
}

static inline int read_int(int *out, error *err) {
    char token[64];
    char *end;
    long value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_int: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtol(token, &end, 10);
    if (end == token || *end != '\0') {
        error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                       "read_int: not an integer");
        return STDLIB_FAIL;
    }
    if (errno == ERANGE || value < INT_MIN || value > INT_MAX) {
        error_fail_cat(err, STDLIB_CATEGORY_RANGE, CPLUS_EXIT_BOUNDS,
                       "read_int: out of range");
        return STDLIB_FAIL;
    }
    *out = (int)value;
    return STDLIB_OK;
}

static inline int read_long(long *out, error *err) {
    char token[64];
    char *end;
    long long value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_long: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtoll(token, &end, 10);
    if (end == token || *end != '\0') {
        error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                       "read_long: not an integer");
        return STDLIB_FAIL;
    }
    if (errno == ERANGE || value < LONG_MIN || value > LONG_MAX) {
        error_fail_cat(err, STDLIB_CATEGORY_RANGE, CPLUS_EXIT_BOUNDS,
                       "read_long: out of range");
        return STDLIB_FAIL;
    }
    *out = (long)value;
    return STDLIB_OK;
}

static inline int read_float(float *out, error *err) {
    char token[64];
    char *end;
    float value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_float: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtof(token, &end);
    if (end == token || *end != '\0') {
        error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                       "read_float: not a number");
        return STDLIB_FAIL;
    }
    /* Policy: reject overflow and non-finite values (inf/nan) rather than
     * letting them propagate silently. */
    if (errno == ERANGE || !isfinite(value)) {
        error_fail_cat(err, STDLIB_CATEGORY_RANGE, CPLUS_EXIT_BOUNDS,
                       "read_float: out of range or not finite");
        return STDLIB_FAIL;
    }
    *out = value;
    return STDLIB_OK;
}

static inline int read_double(double *out, error *err) {
    char token[64];
    char *end;
    double value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_double: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtod(token, &end);
    if (end == token || *end != '\0') {
        error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                       "read_double: not a number");
        return STDLIB_FAIL;
    }
    if (errno == ERANGE || !isfinite(value)) {
        error_fail_cat(err, STDLIB_CATEGORY_RANGE, CPLUS_EXIT_BOUNDS,
                       "read_double: out of range or not finite");
        return STDLIB_FAIL;
    }
    *out = value;
    return STDLIB_OK;
}

#endif
