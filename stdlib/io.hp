/* C+ standard library: convenience I/O and safe interactive input.
 *
 * print()/scan() come from the runtime; this header adds the recoverable,
 * bounded readers.  Conversion is delegated to libc (strtol, strtoll, strtof,
 * strtod) - there is no hand-written number parser here.
 *
 * Every reader returns STDLIB_OK, STDLIB_EOF or STDLIB_FAIL and fills the
 * error argument (cleared on success).
 */
#ifndef CPLUS_STD_IO_HP
#define CPLUS_STD_IO_HP

#include <ctype.h>
#include <errno.h>
#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"

void println(void) {
    print();
}

/* Read one whitespace-delimited token into buf (always NUL-terminated).
 * Returns 0 on success, 1 at end of input.  Reads at most size-1 bytes. */
static inline int stdlib_io_token(char *buf, size_t size) {
    int c;
    size_t stored = 0;
    do {
        c = fgetc(stdin);
    } while (c != EOF && isspace((unsigned char)c));
    if (c == EOF)
        return 1;
    while (c != EOF && !isspace((unsigned char)c)) {
        if (stored + 1 < size)
            buf[stored++] = (char)c;
        c = fgetc(stdin);
    }
    buf[stored] = '\0';
    return 0;
}

static inline int read_line(char *buf, size_t size, error *err) {
    error_reset(err);
    if (buf == NULL || size == 0) {
        error_fail(err, CPLUS_EXIT_IO, "read_line: destination is null or empty");
        return STDLIB_FAIL;
    }
    if (fgets(buf, (int)size, stdin) == NULL) {
        if (feof(stdin))
            return STDLIB_EOF;
        error_fail(err, CPLUS_EXIT_IO, "read_line: input stream error");
        return STDLIB_FAIL;
    }
    {
        size_t n = strlen(buf);
        while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r'))
            buf[--n] = '\0';
    }
    return STDLIB_OK;
}

static inline int read_int(int *out, error *err) {
    char token[64];
    char *end;
    long value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_int: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtol(token, &end, 10);
    if (end == token || *end != '\0') {
        error_fail(err, CPLUS_EXIT_IO, "read_int: not an integer");
        return STDLIB_FAIL;
    }
    if (errno == ERANGE || value < INT_MIN || value > INT_MAX) {
        error_fail(err, CPLUS_EXIT_IO, "read_int: out of range");
        return STDLIB_FAIL;
    }
    *out = (int)value;
    return STDLIB_OK;
}

static inline int read_long(long *out, error *err) {
    char token[64];
    char *end;
    long long value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_long: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtoll(token, &end, 10);
    if (end == token || *end != '\0') {
        error_fail(err, CPLUS_EXIT_IO, "read_long: not an integer");
        return STDLIB_FAIL;
    }
    if (errno == ERANGE || value < LONG_MIN || value > LONG_MAX) {
        error_fail(err, CPLUS_EXIT_IO, "read_long: out of range");
        return STDLIB_FAIL;
    }
    *out = (long)value;
    return STDLIB_OK;
}

static inline int read_float(float *out, error *err) {
    char token[64];
    char *end;
    float value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_float: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtof(token, &end);
    if (end == token || *end != '\0') {
        error_fail(err, CPLUS_EXIT_IO, "read_float: not a number");
        return STDLIB_FAIL;
    }
    if (errno == ERANGE) {
        error_fail(err, CPLUS_EXIT_IO, "read_float: out of range");
        return STDLIB_FAIL;
    }
    *out = value;
    return STDLIB_OK;
}

static inline int read_double(double *out, error *err) {
    char token[64];
    char *end;
    double value;
    error_reset(err);
    if (out == NULL) {
        error_fail(err, CPLUS_EXIT_IO, "read_double: destination is null");
        return STDLIB_FAIL;
    }
    if (stdlib_io_token(token, sizeof(token)) != 0)
        return STDLIB_EOF;
    end = token;
    errno = 0;
    value = strtod(token, &end);
    if (end == token || *end != '\0') {
        error_fail(err, CPLUS_EXIT_IO, "read_double: not a number");
        return STDLIB_FAIL;
    }
    if (errno == ERANGE) {
        error_fail(err, CPLUS_EXIT_IO, "read_double: out of range");
        return STDLIB_FAIL;
    }
    *out = value;
    return STDLIB_OK;
}

#endif
