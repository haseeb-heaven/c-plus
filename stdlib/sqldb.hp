/* C+ modern standard library: SQL-like database (sqldb.hp).
 *
 * Additive, C-style header.  No classes, no templates, no exported symbols,
 * no ABI change.  Deterministic: an in-memory table with insert/select/
 * update/delete/count, plus a plain-text persistence format.
 *
 * Contract (app-facing):
 *   sqldb_insert()  0 ok, -1 table full or bad id
 *   sqldb_select()  0 when not found, else the row (const)
 *   sqldb_update()  0 ok, -1 not found
 *   sqldb_delete()  0 ok, -1 not found
 *   sqldb_save()/sqldb_load()  0 ok, -1 I/O failure
 */
#ifndef CPLUS_STD_SQLDB_HP
#define CPLUS_STD_SQLDB_HP

#include <stdio.h>
#include <string.h>

#define SQLDB_MAX_ROWS 64
#define SQLDB_NAME_LEN 32

typedef struct {
    int used;
    int id;
    int age;
    char name[SQLDB_NAME_LEN];
} sql_row;

typedef struct {
    sql_row rows[SQLDB_MAX_ROWS];
    int count;
} sqldb;

static void sqldb_init(sqldb *db) {
    if (db != (sqldb *)0)
        db->count = 0;
}

static sql_row *sqldb_find(sqldb *db, int id) {
    int i;
    if (db == (sqldb *)0)
        return (sql_row *)0;
    for (i = 0; i < db->count; i++)
        if (db->rows[i].used && db->rows[i].id == id)
            return &db->rows[i];
    return (sql_row *)0;
}

static int sqldb_insert(sqldb *db, int id, int age, const char *name) {
    sql_row *r;
    if (db == (sqldb *)0 || name == (const char *)0)
        return -1;
    r = sqldb_find(db, id);
    if (r == (sql_row *)0) {
        size_t i;
        /* Reclaim a deleted slot before growing the table. */
        for (i = 0; i < db->count; ++i)
            if (!db->rows[i].used) { r = &db->rows[i]; break; }
        if (r == (sql_row *)0) {
            if (db->count >= SQLDB_MAX_ROWS)
                return -1;
            r = &db->rows[db->count++];
        }
    }
    r->used = 1;
    r->id = id;
    r->age = age;
    strncpy(r->name, name, SQLDB_NAME_LEN - 1);
    r->name[SQLDB_NAME_LEN - 1] = 0;
    return 0;
}

static const sql_row *sqldb_select(sqldb *db, int id, int *found) {
    sql_row *r = sqldb_find(db, id);
    if (found != (int *)0)
        *found = (r != (sql_row *)0) ? 1 : 0;
    return (const sql_row *)r;
}

static int sqldb_update(sqldb *db, int id, int age, const char *name) {
    sql_row *r = sqldb_find(db, id);
    if (r == (sql_row *)0)
        return -1;
    r->age = age;
    if (name != (const char *)0) {
        strncpy(r->name, name, SQLDB_NAME_LEN - 1);
        r->name[SQLDB_NAME_LEN - 1] = 0;
    }
    return 0;
}

static int sqldb_delete(sqldb *db, int id) {
    sql_row *r = sqldb_find(db, id);
    if (r == (sql_row *)0)
        return -1;
    r->used = 0;
    r->id = 0;
    r->age = 0;
    r->name[0] = 0;
    return 0;
}

static int sqldb_count(sqldb *db) {
    int i;
    int n = 0;
    if (db == (sqldb *)0)
        return 0;
    for (i = 0; i < db->count; i++)
        if (db->rows[i].used)
            n++;
    return n;
}

static int sqldb_save(sqldb *db, const char *path) {
    FILE *f;
    int i;
    size_t k;
    if (db == (sqldb *)0 || path == (const char *)0)
        return -1;
    f = fopen(path, "w");
    if (f == (FILE *)0)
        return -1;
    for (i = 0; i < db->count; i++) {
        if (!db->rows[i].used) continue;
        /* Hex-encode names so spaces/newlines cannot inject records. */
        fprintf(f, "row %d %d ", db->rows[i].id, db->rows[i].age);
        for (k = 0; db->rows[i].name[k] != 0 && k < SQLDB_NAME_LEN; ++k)
            fprintf(f, "%02x", (unsigned char)db->rows[i].name[k]);
        fprintf(f, "\n");
    }
    fclose(f);
    return 0;
}

static int sqldb_load(sqldb *db, const char *path) {
    FILE *f;
    char line[160];
    if (db == (sqldb *)0 || path == (const char *)0)
        return -1;
    sqldb_init(db);
    f = fopen(path, "r");
    if (f == (FILE *)0)
        return -1;
    while (fgets(line, sizeof(line), f) != (char *)0) {
        int id = 0;
        int age = 0;
        char hex[(SQLDB_NAME_LEN + 1) * 2] = {0};
        char name[SQLDB_NAME_LEN] = {0};
        size_t k;
        if (sscanf(line, "row %d %d %65s", &id, &age, hex) == 3) {
            for (k = 0; hex[2*k] != 0 && hex[2*k+1] != 0 &&
                        k < SQLDB_NAME_LEN; ++k) {
                unsigned int byte = 0;
                if (sscanf(hex + k*2, "%2x", &byte) != 1) break;
                name[k] = (char)(unsigned char)byte;
            }
            name[k] = 0;
            sqldb_insert(db, id, age, name);
        }
    }
    fclose(f);
    return 0;
}

#endif /* CPLUS_STD_SQLDB_HP */
