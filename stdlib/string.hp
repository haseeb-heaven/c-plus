/* C+ standard library: owned string and borrowed view.
 *
 * A thin, RAII-safe wrapper over libc string/memory functions; there is no
 * second string engine here.  `string` owns its buffer and frees it in
 * drop(); `string_view` is a borrowed window and never frees anything.
 */
#ifndef CPLUS_STD_STRING_HP
#define CPLUS_STD_STRING_HP

#include <string.h>
#include "cplus/cplus.h"

/* Borrowed view of a character range, valid while its owner lives. */
class string_view {
    const char *chars;
    size_t count;

    string_view(const char *chars, size_t count) {
        this->chars = chars;
        this->count = count;
    }

    size_t size(void) {
        return this->count;
    }

    const char *data(void) {
        return this->chars;
    }

    int equals(const char *other) {
        size_t n = strlen(other);
        if (n != this->count)
            return 0;
        if (n == 0)
            return 1;
        return memcmp(this->chars, other, n) == 0;
    }
};

class string {
    char *chars;
    size_t count;
    size_t space;

    string(const char *text) {
        size_t n = text == NULL ? 0 : strlen(text);
        this->chars = (char *)cplus_alloc(n + 1);
        if (n > 0)
            memcpy(this->chars, text, n);
        this->chars[n] = '\0';
        this->count = n;
        this->space = n + 1;
    }

    size_t size(void) {
        return this->count;
    }

    size_t capacity(void) {
        return this->space;
    }

    char at(size_t index) {
        if (index >= this->count)
            return '\0';
        return this->chars[index];
    }

    const char *c_str(void) {
        return this->chars;
    }

    int equals(const char *other) {
        size_t other_count = strlen(other);
        if (other_count != this->count)
            return 0;
        return memcmp(this->chars, other, this->count) == 0;
    }

    int compare(const char *other) {
        int r = strcmp(this->chars, other);
        if (r < 0)
            return -1;
        if (r > 0)
            return 1;
        return 0;
    }

    long find(const char *needle) {
        const char *hit;
        if (needle == NULL)
            return -1;
        hit = strstr(this->chars, needle);
        if (hit == NULL)
            return -1;
        return (long)(hit - this->chars);
    }

    /* Ensure room for `want` bytes including the terminator. */
    int reserve(size_t want) {
        char *fresh;
        if (want <= this->space)
            return 0;
        fresh = (char *)cplus_alloc(want);
        memcpy(fresh, this->chars, this->count + 1);
        if (this->chars != NULL)
            cplus_release(this->chars);
        this->chars = fresh;
        this->space = want;
        return 0;
    }

    int append(const char *text) {
        size_t extra = text == NULL ? 0 : strlen(text);
        size_t need;
        size_t want;
        if (extra == 0)
            return 0;
        if (this->count > SIZE_MAX - extra - 1)
            return -1;
        need = this->count + extra + 1;
        if (need > this->space) {
            want = need;
            if (this->space > 0 && this->space <= SIZE_MAX / 2) {
                want = this->space * 2;
                if (want < need)
                    want = need;
            }
            if (string_reserve(this, want) != 0)
                return -1;
        }
        memcpy(this->chars + this->count, text, extra);
        this->count += extra;
        this->chars[this->count] = '\0';
        return 0;
    }

    void clear(void) {
        if (this->chars != NULL)
            this->chars[0] = '\0';
        this->count = 0;
    }

    /* Copy up to `n` characters from `start` into `out`. */
    int substr(size_t start, size_t n, char *out, size_t out_size) {
        size_t available;
        if (out == NULL || out_size == 0)
            return -1;
        if (start > this->count)
            return -1;
        available = this->count - start;
        if (n > available)
            n = available;
        if (n + 1 > out_size)
            n = out_size - 1;
        memcpy(out, this->chars + start, n);
        out[n] = '\0';
        return 0;
    }

    /* Number of separator-delimited fields (1 when sep is absent). */
    size_t count_fields(char sep) {
        size_t fields = 1;
        size_t i;
        for (i = 0; i < this->count; i++)
            if (this->chars[i] == sep)
                fields++;
        return fields;
    }

    /* Copy the index-th separator-delimited field into out. */
    int field(char sep, size_t index, char *out, size_t out_size) {
        size_t current = 0;
        size_t start = 0;
        size_t i;
        if (out == NULL || out_size == 0)
            return -1;
        for (i = 0; i <= this->count; i++) {
            if (i == this->count || this->chars[i] == sep) {
                if (current == index) {
                    size_t n = i - start;
                    if (n + 1 > out_size)
                        n = out_size - 1;
                    memcpy(out, this->chars + start, n);
                    out[n] = '\0';
                    return 0;
                }
                current++;
                start = i + 1;
            }
        }
        return -1;
    }

    string_view to_view(void) {
        string_view borrowed;
        borrowed.chars = this->chars;
        borrowed.count = this->count;
        return borrowed;
    }

    void drop(void) {
        if (this->chars != NULL) {
            cplus_release(this->chars);
            this->chars = NULL;
            this->count = 0;
            this->space = 0;
        }
    }
};

#endif
