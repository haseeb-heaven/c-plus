/* C+ standard library: owned string.
 * Thin safe wrapper over libc string functions; no new string engine. */
#ifndef CPLUS_STD_STRING_HP
#define CPLUS_STD_STRING_HP

#include <string.h>
#include "cplus/cplus.h"

class String {
    char *data;
    size_t length;

    String(const char *text) {
        size_t n = strlen(text);
        cplus_log(CPLUS_LOG_DEBUG, "String ctor len=%zu", n);
        self->data = (char *)cplus_alloc(n + 1);
        memcpy(self->data, text, n + 1);
        self->length = n;
    }

    size_t len(void) {
        cplus_log(CPLUS_LOG_TRACE, "String len=%zu", self->length);
        return self->length;
    }

    char at(size_t index) {
        cplus_log(CPLUS_LOG_TRACE, "String at=%zu len=%zu", index,
                  self->length);
        if (index >= self->length)
            return '\0';
        return self->data[index];
    }

    const char *c_str(void) {
        cplus_log(CPLUS_LOG_TRACE, "String c_str");
        return self->data;
    }

    void drop(void) {
        cplus_log(CPLUS_LOG_DEBUG, "String drop len=%zu", self->length);
        if (self->data != NULL) {
            cplus_release(self->data);
            self->data = NULL;
            self->length = 0;
        }
    }
};

#endif
