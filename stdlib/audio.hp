/* C+ standard library: audio via miniaudio (public domain / MIT-0, vendored in
 * third_party/miniaudio).
 *
 * C++-flavoured RAII: `audio_engine e = audio_engine(&err);` plays, `e.load()`
 * returns an owned sound, and every handle releases its resource in drop().
 * Mixing and decoding are miniaudio's job.
 *
 * Constructors never use `->` on other objects, because a C+ constructor body
 * rewrites `->` to `.` (that is how `this->field` maps to the result struct).
 * Pass a native pointer instead.
 */
#ifndef CPLUS_STD_AUDIO_HP
#define CPLUS_STD_AUDIO_HP

#include <errno.h>
#include <math.h>
#include <stdlib.h>
#include <time.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"
#include "miniaudio.h"

class audio_context {
    ma_context context;
    int initialized;

    audio_context(int use_null, error *err) {
        do {
            ma_result rc;
            error_reset(err);
            this->initialized = 0;
            if (use_null) {
                ma_backend backends[2];
                backends[0] = ma_backend_null;
                backends[1] = ma_backend_null;
                rc = ma_context_init(backends, 1, NULL, &this->context);
            } else {
                rc = ma_context_init(NULL, 0, NULL, &this->context);
            }
            if (rc != MA_SUCCESS) {
                error_fail(err, CPLUS_EXIT_RESOURCE, "audio_context: init failed");
                break;
            }
            this->initialized = 1;
        } while (0);
    }

    int valid(void) {
        return this->initialized != 0;
    }

    /* Borrowed native context for APIs that need the miniaudio type. */
    ma_context *native(void) {
        return &this->context;
    }

    void drop(void) {
        if (this->initialized) {
            ma_context_uninit(&this->context);
            this->initialized = 0;
        }
    }
};

class audio_sound {
    ma_sound sound;
    int initialized;

    /* Takes the native engine pointer: a constructor must not use `->`. */
    audio_sound(ma_engine *owner_engine, const char *path, error *err) {
        do {
            error_reset(err);
            this->initialized = 0;
            if (owner_engine == NULL || path == NULL) {
                error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_sound: invalid argument");
                break;
            }
            if (ma_sound_init_from_file(owner_engine, path, 0, NULL, NULL,
                                        &this->sound) != MA_SUCCESS) {
                error_fail(err, CPLUS_EXIT_IO, "audio_sound: cannot load file");
                break;
            }
            this->initialized = 1;
        } while (0);
    }

    int valid(void) {
        return this->initialized != 0;
    }

    int play(error *err) {
        error_reset(err);
        if (!this->valid()) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_sound::play: invalid sound");
            return STDLIB_FAIL;
        }
        if (ma_sound_start(&this->sound) != MA_SUCCESS) {
            error_fail(err, CPLUS_EXIT_IO, "audio_sound::play failed");
            return STDLIB_FAIL;
        }
        return STDLIB_OK;
    }

    int stop(error *err) {
        error_reset(err);
        if (!this->valid()) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_sound::stop: invalid sound");
            return STDLIB_FAIL;
        }
        if (ma_sound_stop(&this->sound) != MA_SUCCESS) {
            error_fail(err, CPLUS_EXIT_IO, "audio_sound::stop failed");
            return STDLIB_FAIL;
        }
        return STDLIB_OK;
    }

    int playing(void) {
        return this->valid() && ma_sound_is_playing(&this->sound);
    }

    void drop(void) {
        if (this->initialized) {
            ma_sound_uninit(&this->sound);
            this->initialized = 0;
        }
    }
};

class audio_engine {
    ma_engine engine;
    int initialized;

    /* Takes the native context so callers can select a backend (the silent
     * null backend in tests); a constructor must not use `->`. */
    audio_engine(ma_context *owner_context, error *err) {
        ma_engine_config config;
        do {
            error_reset(err);
            this->initialized = 0;
            config = ma_engine_config_init();
            config.pContext = owner_context;
            if (ma_engine_init(&config, &this->engine) != MA_SUCCESS) {
                error_fail(err, CPLUS_EXIT_RESOURCE, "audio_engine: init failed");
                break;
            }
            this->initialized = 1;
        } while (0);
    }

    int valid(void) {
        return this->initialized != 0;
    }

    ma_engine *native(void) {
        return &this->engine;
    }

    int set_volume(float volume, error *err) {
        error_reset(err);
        if (!this->valid()) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_engine::set_volume: invalid engine");
            return STDLIB_FAIL;
        }
        /* NaN, +/-Inf and negative gain would poison the mixer graph. */
        if (!isfinite(volume) || volume < 0.0f) {
            error_fail_cat(err, STDLIB_CATEGORY_RANGE, CPLUS_EXIT_BOUNDS,
                           "audio_engine::set_volume: volume must be finite and non-negative");
            return STDLIB_FAIL;
        }
        ma_engine_set_volume(&this->engine, volume);
        return STDLIB_OK;
    }

    /* Fire-and-forget playback of a file or resource. */
    int play(const char *path, error *err) {
        error_reset(err);
        if (!this->valid() || path == NULL) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_engine::play: invalid argument");
            return STDLIB_FAIL;
        }
        if (ma_engine_play_sound(&this->engine, path, NULL) != MA_SUCCESS) {
            error_fail(err, CPLUS_EXIT_IO, "audio_engine::play: cannot play");
            return STDLIB_FAIL;
        }
        return STDLIB_OK;
    }

    /* Loads an owned sound; check sound.valid() before playing. */
    audio_sound load(const char *path, error *err) {
        audio_sound loaded = audio_sound(&this->engine, path, err);
        return loaded;
    }

    void drop(void) {
        if (this->initialized) {
            ma_engine_uninit(&this->engine);
            this->initialized = 0;
        }
    }
};

class audio_device {
    ma_device device;
    int initialized;

    audio_device(ma_context *owner_context, int capture, unsigned sample_rate,
                 unsigned channels, ma_device_data_proc callback, void *user,
                 error *err) {
        ma_device_config config;
        error_reset(err);
        this->initialized = 0;
        if (owner_context == NULL) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_device: invalid context");
        } else if (sample_rate == 0u || channels == 0u || callback == NULL) {
            /* Explicit zero/NULL arguments must fail here: miniaudio would
             * otherwise substitute defaults or silently no-op. */
            error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_UNSUPPORTED,
                           "audio_device: sample_rate, channels and callback must be non-zero");
        } else {
            config = ma_device_config_init(capture ? ma_device_type_capture
                                                   : ma_device_type_playback);
            config.sampleRate = sample_rate;
            config.dataCallback = callback;
            config.pUserData = user;
            if (capture) {
                config.capture.format = ma_format_f32;
                config.capture.channels = channels;
            } else {
                config.playback.format = ma_format_f32;
                config.playback.channels = channels;
            }
            if (ma_device_init(owner_context, &config, &this->device) == MA_SUCCESS) {
                this->initialized = 1;
            } else {
                error_fail(err, CPLUS_EXIT_RESOURCE, "audio_device: init failed");
            }
        }
    }

    int valid(void) {
        return this->initialized != 0;
    }

    int start(error *err) {
        error_reset(err);
        if (!this->valid()) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_device::start: invalid device");
            return STDLIB_FAIL;
        }
        if (ma_device_start(&this->device) != MA_SUCCESS) {
            error_fail(err, CPLUS_EXIT_IO, "audio_device::start failed");
            return STDLIB_FAIL;
        }
        return STDLIB_OK;
    }

    int stop(error *err) {
        error_reset(err);
        if (!this->valid()) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_device::stop: invalid device");
            return STDLIB_FAIL;
        }
        if (ma_device_stop(&this->device) != MA_SUCCESS) {
            error_fail(err, CPLUS_EXIT_IO, "audio_device::stop failed");
            return STDLIB_FAIL;
        }
        return STDLIB_OK;
    }

    int running(void) {
        return this->valid() && ma_device_is_started(&this->device);
    }

    void drop(void) {
        if (this->initialized) {
            ma_device_uninit(&this->device);
            this->initialized = 0;
        }
    }
};

class audio_decoder {
    ma_decoder decoder;
    int initialized;

    audio_decoder(const char *path, error *err) {
        do {
            ma_decoder_config config = ma_decoder_config_init(ma_format_f32, 0, 0);
            error_reset(err);
            this->initialized = 0;
            if (path == NULL)
                break;
            if (ma_decoder_init_file(path, &config, &this->decoder) != MA_SUCCESS) {
                error_fail(err, CPLUS_EXIT_IO, "audio_decoder: cannot open file");
                break;
            }
            this->initialized = 1;
        } while (0);
    }

    int valid(void) {
        return this->initialized != 0;
    }

    unsigned channels(void) {
        return this->valid() ? this->decoder.outputChannels : 0;
    }

    unsigned sample_rate(void) {
        return this->valid() ? this->decoder.outputSampleRate : 0;
    }

    unsigned long long frame_count(void) {
        ma_uint64 frames = 0;
        if (!this->valid())
            return 0;
        if (ma_decoder_get_length_in_pcm_frames(&this->decoder, &frames) != MA_SUCCESS)
            return 0;
        return (unsigned long long)frames;
    }

    /* Reads up to frame_count interleaved f32 frames; returns frames read. */
    unsigned long long read(float *frames, unsigned long long frame_count,
                            error *err) {
        ma_uint64 read = 0;
        error_reset(err);
        if (!this->valid() || frames == NULL) {
            error_fail(err, CPLUS_EXIT_UNSUPPORTED, "audio_decoder::read: invalid argument");
            return 0;
        }
        if (frame_count == 0)
            return 0;
        if (ma_decoder_read_pcm_frames(&this->decoder, frames, frame_count,
                                       &read) != MA_SUCCESS) {
            error_fail(err, CPLUS_EXIT_IO, "audio_decoder::read failed");
            return 0;
        }
        return (unsigned long long)read;
    }

    void drop(void) {
        if (this->initialized) {
            ma_decoder_uninit(&this->decoder);
            this->initialized = 0;
        }
    }
};

static inline audio_decoder decoder_from_memory(const void *data, size_t size,
                                                error *err) {
    audio_decoder out = audio_decoder(NULL, err);
    ma_decoder_config config = ma_decoder_config_init(ma_format_f32, 0, 0);
    error_reset(err);
    if (data == NULL || size == 0) {
        error_fail(err, CPLUS_EXIT_IO, "decoder_from_memory: empty buffer");
        return out;
    }
    if (ma_decoder_init_memory(data, size, &config, &out.decoder) != MA_SUCCESS) {
        error_fail(err, CPLUS_EXIT_IO, "decoder_from_memory: not decodable");
        return out;
    }
    out.initialized = 1;
    return out;
}

/* Sleep without pulling in implementation-private miniaudio helpers. */
static inline void audio_sleep_ms(unsigned ms) {
    struct timespec req;
    struct timespec rem;
    req.tv_sec = (time_t)(ms / 1000u);
    req.tv_nsec = (long)((ms % 1000u) * 1000000u);
    while (nanosleep(&req, &rem) == -1 && errno == EINTR)
        req = rem;
}

#endif
