/* C+ standard library: RAII TCP listener/connection over POSIX sockets.
 *
 * C++-flavoured: `listener l = listener(port); connection c = l.accept();`.
 * Each handle records whether it owns its descriptor, so a zero-initialised or
 * borrowed handle never closes anything and a moved-from handle is inert.
 */
#ifndef CPLUS_STD_NET_HP
#define CPLUS_STD_NET_HP

#include <arpa/inet.h>
#include <errno.h>
#include <limits.h>
#include <netinet/in.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"

/* SIGPIPE has a fatal default disposition: a peer that disconnects mid-write
 * may otherwise kill the whole process.  macOS/BSD expose SO_NOSIGPIPE, set
 * here on every socket a connection owns or borrows (including accepted
 * ones), so write() surfaces EPIPE.  Linux has no SO_NOSIGPIPE; there
 * connection::write() uses send() with MSG_NOSIGNAL below. */
static inline void net_no_sigpipe(int fd) {
#ifdef SO_NOSIGPIPE
    int set = 1;
    if (fd >= 0)
        (void)setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &set, sizeof(set));
#else
    (void)fd;
#endif
}

class connection {
    int fd;
    int owns;

    connection(int descriptor) {
        this->fd = descriptor;
        this->owns = descriptor >= 0 ? 1 : 0;
        net_no_sigpipe(this->fd);
    }

    /* Descriptors 0-2 belong to the process: a zero-initialised handle (fd 0,
     * owns 0) must not look usable, and a borrowed handle never claims them. */
    int is_valid(void) {
        return this->fd >= 3 || (this->owns && this->fd >= 0);
    }

    int descriptor(void) {
        return this->fd;
    }

    /* Reads at most size bytes: byte count, STDLIB_EOF at end of stream,
     * STDLIB_FAIL with err set. */
    int read(char *buf, size_t capacity, error *err) {
        ssize_t n;
        error_reset(err);
        if (!this->is_valid() || buf == NULL || capacity == 0) {
            error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_IO,
                           "connection::read: invalid argument");
            return STDLIB_FAIL;
        }
        if (capacity > (size_t)INT_MAX)
            capacity = (size_t)INT_MAX;
        do {
            n = read(this->fd, buf, capacity);
        } while (n < 0 && errno == EINTR);
        if (n < 0) {
            error_fail_cat(err, STDLIB_CATEGORY_IO, CPLUS_EXIT_IO,
                           "connection::read failed");
            return STDLIB_FAIL;
        }
        if (n == 0)
            return STDLIB_EOF;
        return (int)n;
    }

    int write(const char *data, size_t length, error *err) {
        size_t sent = 0;
        error_reset(err);
        if (!this->is_valid() || data == NULL) {
            error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_IO,
                           "connection::write: invalid argument");
            return STDLIB_FAIL;
        }
        /* A short write is not a failure: keep sending until every byte is out
         * (retrying EINTR) or the peer reports an error. */
        while (sent < length) {
            ssize_t n;
#if defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
            /* Linux: no per-socket SO_NOSIGPIPE, so suppress the signal on
             * this send.  macOS/BSD keep write() because the option above
             * already makes it safe. */
            n = send(this->fd, data + sent, length - sent, MSG_NOSIGNAL);
#else
            n = write(this->fd, data + sent, length - sent);
#endif
            if (n < 0) {
                if (errno == EINTR)
                    continue;
                error_fail_cat(err, STDLIB_CATEGORY_IO, CPLUS_EXIT_IO,
                               "connection::write failed");
                return STDLIB_FAIL;
            }
            if (n == 0) {
                error_fail_cat(err, STDLIB_CATEGORY_IO, CPLUS_EXIT_IO,
                               "connection::write made no progress");
                return STDLIB_FAIL;
            }
            sent += (size_t)n;
        }
        return STDLIB_OK;
    }

    void drop(void) {
        if (this->owns && this->fd >= 0)
            close(this->fd);
        this->fd = -1;
        this->owns = 0;
    }
};

class listener {
    int fd;
    int owns;

    /* No early return: C+ constructors have no return statement. */
    listener(int port) {
        int yes = 1;
        struct sockaddr_in addr;
        this->fd = -1;
        this->owns = 0;
        if (port >= 0 && port <= 65535) {
            this->fd = socket(AF_INET, SOCK_STREAM, 0);
            if (this->fd >= 0) {
                setsockopt(this->fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
                memset(&addr, 0, sizeof(addr));
                addr.sin_family = AF_INET;
                addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
                addr.sin_port = htons((unsigned short)port);
                if (bind(this->fd, (struct sockaddr *)&addr, sizeof(addr)) == 0 &&
                    listen(this->fd, 1) == 0) {
                    this->owns = 1;
                } else {
                    close(this->fd);
                    this->fd = -1;
                }
            }
        }
    }

    /* Descriptors 0-2 belong to the process: a zero-initialised handle (fd 0,
     * owns 0) must not look usable, and a borrowed handle never claims them. */
    int is_valid(void) {
        return this->fd >= 3 || (this->owns && this->fd >= 0);
    }

    int descriptor(void) {
        return this->fd;
    }

    int bound_port(void) {
        struct sockaddr_in bound;
        socklen_t len = sizeof(bound);
        if (!this->is_valid())
            return 0;
        if (getsockname(this->fd, (struct sockaddr *)&bound, &len) != 0)
            return 0;
        return ntohs(bound.sin_port);
    }

    connection accept(void) {
        int client_fd = -1;
        if (this->is_valid()) {
            do {
                client_fd = accept(this->fd, NULL, NULL);
            } while (client_fd < 0 && errno == EINTR);
        }
        connection accepted = connection(client_fd);
        return accepted;
    }

    void drop(void) {
        if (this->owns && this->fd >= 0)
            close(this->fd);
        this->fd = -1;
        this->owns = 0;
    }
};

/* Wrap an existing descriptor without taking ownership of closing it. */
static inline listener listener_borrow(int fd) {
    listener borrowed = listener(-1);
    borrowed.fd = fd;
    borrowed.owns = 0;
    return borrowed;
}

static inline connection connection_borrow(int fd) {
    /* Use the fd-taking constructor so SO_NOSIGPIPE is applied to borrowed
     * descriptors too; only ownership is cleared afterwards. */
    connection borrowed = connection(fd);
    borrowed.owns = 0;
    return borrowed;
}

#endif
