/* C+ standard library: RAII TCP listener/connection over POSIX sockets.
 *
 * C++-flavoured: `listener l = listener(port); connection c = l.accept();`.
 * Each handle records whether it owns its descriptor, so a zero-initialised or
 * borrowed handle never closes anything and a moved-from handle is inert.
 */
#ifndef CPLUS_STD_NET_HP
#define CPLUS_STD_NET_HP

#include <arpa/inet.h>
#include <errno.h>
#include <limits.h>
#include <netinet/in.h>
#include <signal.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"

/* A reset peer must turn into an EPIPE-style write error, not a process-killing
 * SIGPIPE.  Linux has MSG_NOSIGNAL per send; BSD/macOS have SO_NOSIGPIPE per
 * socket (inherited by accepted sockets).  Apply the socket option at write
 * time as well so borrowed descriptors get the same protection. */
static void net_suppress_sigpipe(int fd) {
#ifdef SO_NOSIGPIPE
    int one = 1;
    if (fd >= 0)
        (void)setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
#else
    (void)fd;
#endif
}

static int net_send_flags(void) {
#ifdef MSG_NOSIGNAL
    return MSG_NOSIGNAL;
#else
    return 0;
#endif
}

/* Last-resort POSIX fallback: ignore SIGPIPE only around the send loop and
 * restore the previous handler/mask when done. */
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
typedef struct {
    struct sigaction previous;
    int installed;
} net_sigpipe_scope;

static void net_sigpipe_scope_enter(net_sigpipe_scope *scope) {
    struct sigaction ignore;
    scope->installed = 0;
    memset(&ignore, 0, sizeof(ignore));
    ignore.sa_handler = SIG_IGN;
    sigemptyset(&ignore.sa_mask);
    if (sigaction(SIGPIPE, &ignore, &scope->previous) == 0)
        scope->installed = 1;
}

static void net_sigpipe_scope_leave(net_sigpipe_scope *scope) {
    if (scope->installed)
        (void)sigaction(SIGPIPE, &scope->previous, (struct sigaction *)0);
}
#endif

class connection {
    int fd;
    int owns;

    connection(int descriptor) {
        this->fd = descriptor;
        this->owns = descriptor >= 0 ? 1 : 0;
    }

    /* Descriptors 0-2 belong to the process: a zero-initialised handle (fd 0,
     * owns 0) must not look usable, and a borrowed handle never claims them. */
    int is_valid(void) {
        return this->fd >= 3 || (this->owns && this->fd >= 0);
    }

    int descriptor(void) {
        return this->fd;
    }

    /* Reads at most size bytes: byte count, STDLIB_EOF at end of stream,
     * STDLIB_FAIL with err set. */
    int read(char *buf, size_t capacity, error *err) {
        ssize_t n;
        error_reset(err);
        if (!this->is_valid() || buf == NULL || capacity == 0) {
            error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_IO,
                           "connection::read: invalid argument");
            return STDLIB_FAIL;
        }
        if (capacity > (size_t)INT_MAX)
            capacity = (size_t)INT_MAX;
        do {
            n = read(this->fd, buf, capacity);
        } while (n < 0 && errno == EINTR);
        if (n < 0) {
            error_fail_cat(err, STDLIB_CATEGORY_IO, CPLUS_EXIT_IO,
                           "connection::read failed");
            return STDLIB_FAIL;
        }
        if (n == 0)
            return STDLIB_EOF;
        return (int)n;
    }

    int write(const char *data, size_t length, error *err) {
        size_t sent = 0;
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
        net_sigpipe_scope sigpipe_scope;
#endif
        error_reset(err);
        if (!this->is_valid() || data == NULL) {
            error_fail_cat(err, STDLIB_CATEGORY_INVALID, CPLUS_EXIT_IO,
                           "connection::write: invalid argument");
            return STDLIB_FAIL;
        }
        net_suppress_sigpipe(this->fd);
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
        net_sigpipe_scope_enter(&sigpipe_scope);
#endif
        /* A short write is not a failure: keep sending until every byte is out
         * (retrying EINTR) or the peer reports an error.  send() plus
         * MSG_NOSIGNAL/SO_NOSIGPIPE keeps EPIPE recoverable. */
        while (sent < length) {
            ssize_t n = send(this->fd, data + sent, length - sent,
                             net_send_flags());
            if (n < 0) {
                if (errno == EINTR)
                    continue;
                error_fail_cat(err, STDLIB_CATEGORY_IO, CPLUS_EXIT_IO,
                               "connection::write failed");
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
                net_sigpipe_scope_leave(&sigpipe_scope);
#endif
                return STDLIB_FAIL;
            }
            if (n == 0) {
                error_fail_cat(err, STDLIB_CATEGORY_IO, CPLUS_EXIT_IO,
                               "connection::write made no progress");
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
                net_sigpipe_scope_leave(&sigpipe_scope);
#endif
                return STDLIB_FAIL;
            }
            sent += (size_t)n;
        }
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
        net_sigpipe_scope_leave(&sigpipe_scope);
#endif
        return STDLIB_OK;
    }

    void drop(void) {
        if (this->owns && this->fd >= 0)
            close(this->fd);
        this->fd = -1;
        this->owns = 0;
    }
};

class listener {
    int fd;
    int owns;

    /* No early return: C+ constructors have no return statement. */
    listener(int port) {
        int yes = 1;
        struct sockaddr_in addr;
        this->fd = -1;
        this->owns = 0;
        if (port >= 0 && port <= 65535) {
            this->fd = socket(AF_INET, SOCK_STREAM, 0);
            if (this->fd >= 0) {
                setsockopt(this->fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
                net_suppress_sigpipe(this->fd);
                memset(&addr, 0, sizeof(addr));
                addr.sin_family = AF_INET;
                addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
                addr.sin_port = htons((unsigned short)port);
                if (bind(this->fd, (struct sockaddr *)&addr, sizeof(addr)) == 0 &&
                    listen(this->fd, 1) == 0) {
                    this->owns = 1;
                } else {
                    close(this->fd);
                    this->fd = -1;
                }
            }
        }
    }

    /* Descriptors 0-2 belong to the process: a zero-initialised handle (fd 0,
     * owns 0) must not look usable, and a borrowed handle never claims them. */
    int is_valid(void) {
        return this->fd >= 3 || (this->owns && this->fd >= 0);
    }

    int descriptor(void) {
        return this->fd;
    }

    int bound_port(void) {
        struct sockaddr_in bound;
        socklen_t len = sizeof(bound);
        if (!this->is_valid())
            return 0;
        if (getsockname(this->fd, (struct sockaddr *)&bound, &len) != 0)
            return 0;
        return ntohs(bound.sin_port);
    }

    connection accept(void) {
        int client_fd = -1;
        if (this->is_valid()) {
            do {
                client_fd = accept(this->fd, NULL, NULL);
            } while (client_fd < 0 && errno == EINTR);
        }
        net_suppress_sigpipe(client_fd);
        connection accepted = connection(client_fd);
        return accepted;
    }

    void drop(void) {
        if (this->owns && this->fd >= 0)
            close(this->fd);
        this->fd = -1;
        this->owns = 0;
    }
};

/* Wrap an existing descriptor without taking ownership of closing it. */
static inline listener listener_borrow(int fd) {
    listener borrowed = listener(-1);
    borrowed.fd = fd;
    borrowed.owns = 0;
    return borrowed;
}

static inline connection connection_borrow(int fd) {
    connection borrowed = connection(-1);
    borrowed.fd = fd;
    borrowed.owns = 0;
    return borrowed;
}

#endif
