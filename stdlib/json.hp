/* C+ standard library: JSON via yyjson (MIT, vendored in third_party/yyjson).
 *
 * RAII-over-upstream, not a new parser: yyjson parses, serialises and owns the
 * memory; this header only adds lifetime-safety and error results.
 *
 *   JsonDoc      owns a parsed document      -> drop() frees it
 *   JsonRef      borrows a value inside a doc -> never frees anything
 *   JsonBuilder  owns a mutable document      -> drop() frees it
 *
 * A JsonRef is only valid while its JsonDoc/JsonBuilder is alive; the write
 * helpers return a malloc'd buffer that the caller releases with Json_free().
 *
 * Build third_party/yyjson/yyjson.c once as a normal C translation unit and
 * add third_party/yyjson to the include path.
 */
#ifndef CPLUS_STD_JSON_HP
#define CPLUS_STD_JSON_HP

#include <stdlib.h>
#include <string.h>
#include "cplus/cplus.h"
#include "stdlib/error.hp"
#include "yyjson.h"

/* ---- borrowed value ----------------------------------------------------- */

typedef struct JsonRef {
    const yyjson_val *val;
} JsonRef;

static inline int JsonRef_valid(const JsonRef *self) {
    return self->val != NULL;
}

static inline int JsonRef_is_obj(const JsonRef *self) {
    return yyjson_is_obj(self->val);
}

static inline int JsonRef_is_arr(const JsonRef *self) {
    return yyjson_is_arr(self->val);
}

static inline int JsonRef_is_num(const JsonRef *self) {
    return yyjson_is_num(self->val);
}

static inline int JsonRef_is_str(const JsonRef *self) {
    return yyjson_is_str(self->val);
}

static inline int JsonRef_is_bool(const JsonRef *self) {
    return yyjson_is_bool(self->val);
}

static inline int JsonRef_int(const JsonRef *self, int *out) {
    if (out == NULL || !yyjson_is_num(self->val))
        return -1;
    *out = yyjson_get_int(self->val);
    return 0;
}

static inline int JsonRef_double(const JsonRef *self, double *out) {
    if (out == NULL || !yyjson_is_num(self->val))
        return -1;
    *out = yyjson_get_num(self->val);
    return 0;
}

static inline int JsonRef_bool(const JsonRef *self, int *out) {
    if (out == NULL || !yyjson_is_bool(self->val))
        return -1;
    *out = yyjson_get_bool(self->val) ? 1 : 0;
    return 0;
}

/* Borrowed string: valid while the owning document is alive.  Never free it. */
static inline int JsonRef_str(const JsonRef *self, const char **out) {
    if (out == NULL || !yyjson_is_str(self->val))
        return -1;
    *out = yyjson_get_str(self->val);
    return 0;
}

static inline size_t JsonRef_size(const JsonRef *self) {
    if (yyjson_is_arr(self->val))
        return yyjson_arr_size(self->val);
    if (yyjson_is_obj(self->val))
        return yyjson_obj_size(self->val);
    return 0;
}

static inline JsonRef JsonRef_arr_at(const JsonRef *self, size_t index) {
    JsonRef ref;
    ref.val = yyjson_arr_get(self->val, index);
    return ref;
}

static inline JsonRef JsonRef_member(const JsonRef *self, const char *key) {
    JsonRef ref;
    ref.val = (self->val == NULL || key == NULL) ? NULL
                                                 : yyjson_obj_get(self->val, key);
    return ref;
}

/* Serialise a borrowed value; free the result with Json_free(). */
static inline char *JsonRef_write(const JsonRef *self, size_t *len) {
    if (self->val == NULL)
        return NULL;
    return yyjson_val_write(self->val, YYJSON_WRITE_NOFLAG, len);
}

static inline void Json_free(char *text) {
    free(text);
}

/* ---- owned parsed document ---------------------------------------------- */

resource struct JsonDoc {
    yyjson_doc *doc;
};

static inline void JsonDoc_drop(JsonDoc *self) {
    if (self->doc != NULL) {
        yyjson_doc_free(self->doc);
        self->doc = NULL;
    }
}

static inline int JsonDoc_valid(const JsonDoc *self) {
    return self->doc != NULL;
}

static inline JsonRef JsonDoc_root(const JsonDoc *self) {
    JsonRef ref;
    ref.val = self->doc == NULL ? NULL : yyjson_doc_get_root(self->doc);
    return ref;
}

static inline JsonDoc JsonDoc_parse(const char *text, StdError *err) {
    JsonDoc doc;
    yyjson_read_err info;
    StdError_init(err);
    doc.doc = NULL;
    if (text == NULL) {
        StdError_set(err, CPLUS_EXIT_UNSUPPORTED, "JsonDoc_parse: null input");
        return doc;
    }
    /* yyjson reads without modifying the buffer. */
    doc.doc = yyjson_read_opts((char *)text, strlen(text), YYJSON_READ_NOFLAG,
                               NULL, &info);
    if (doc.doc == NULL) {
        StdError_set(err, CPLUS_EXIT_UNSUPPORTED,
                     info.msg != NULL ? info.msg : "JSON parse failed");
    }
    return doc;
}

static inline JsonDoc JsonDoc_read_file(const char *path, StdError *err) {
    JsonDoc doc;
    yyjson_read_err info;
    StdError_init(err);
    doc.doc = NULL;
    if (path == NULL) {
        StdError_set(err, CPLUS_EXIT_IO, "JsonDoc_read_file: null path");
        return doc;
    }
    doc.doc = yyjson_read_file(path, YYJSON_READ_NOFLAG, NULL, &info);
    if (doc.doc == NULL) {
        StdError_set(err, CPLUS_EXIT_IO,
                     info.msg != NULL ? info.msg : "JSON file read failed");
    }
    return doc;
}

/* ---- owned mutable document (builder) ----------------------------------- */

resource struct JsonBuilder {
    yyjson_mut_doc *doc;
    yyjson_mut_val *root;
};

static inline void JsonBuilder_drop(JsonBuilder *self) {
    if (self->doc != NULL) {
        yyjson_mut_doc_free(self->doc);
        self->doc = NULL;
        self->root = NULL;
    }
}

static inline int JsonBuilder_valid(const JsonBuilder *self) {
    return self->doc != NULL && self->root != NULL;
}

static inline JsonBuilder JsonBuilder_new(void) {
    JsonBuilder builder;
    builder.doc = yyjson_mut_doc_new(NULL);
    builder.root = NULL;
    if (builder.doc != NULL) {
        builder.root = yyjson_mut_obj(builder.doc);
        if (builder.root != NULL)
            yyjson_mut_doc_set_root(builder.doc, builder.root);
    }
    return builder;
}

static inline int JsonBuilder_add_int(JsonBuilder *self, const char *key,
                                      int value) {
    if (!JsonBuilder_valid(self))
        return -1;
    return yyjson_mut_obj_add_int(self->doc, self->root, key, value) ? 0 : -1;
}

static inline int JsonBuilder_add_double(JsonBuilder *self, const char *key,
                                         double value) {
    if (!JsonBuilder_valid(self))
        return -1;
    return yyjson_mut_obj_add_double(self->doc, self->root, key, value) ? 0 : -1;
}

static inline int JsonBuilder_add_bool(JsonBuilder *self, const char *key,
                                       int value) {
    if (!JsonBuilder_valid(self))
        return -1;
    return yyjson_mut_obj_add_bool(self->doc, self->root, key, value != 0) ? 0
                                                                          : -1;
}

/* Copies `value`, so the caller keeps ownership of its buffer. */
static inline int JsonBuilder_add_str(JsonBuilder *self, const char *key,
                                      const char *value) {
    if (!JsonBuilder_valid(self) || value == NULL)
        return -1;
    return yyjson_mut_obj_add_strcpy(self->doc, self->root, key, value) ? 0 : -1;
}

/* Serialise the builder; free the result with Json_free(). */
static inline char *JsonBuilder_write(JsonBuilder *self, size_t *len) {
    if (!JsonBuilder_valid(self))
        return NULL;
    return yyjson_mut_write(self->doc, YYJSON_WRITE_NOFLAG, len);
}

#endif
