/* C+ modern standard library: minimal POSIX HTTP/1.1 server (web.hp).
 *
 * Additive, C-style header.  No classes, no templates, no exported symbols,
 * no ABI change.  Deterministic behavior: a web server bound to host:port,
 * a tiny request parser, and reply helpers.  POSIX sockets only
 * (non-blocking off; single accept loop; the host app iterates).
 *
 * Contract:
 *   web_server_start() returns a non-null web_server on success, 0 on failure.
 *   web_accept() returns 1 with a filled web_conn, 0 on timeout/error (see
 *   srv->nap_ms), -1 on terminal failure.
 *   web_reply() writes a response line and body; body may be "" or NULL
 *   (treated as empty).  Both header and body sends are checked for short
 *   writes and truncation.
 *   web_server_stop() closes the listening socket.
 *
 * Request reads are bounded: a client that connects but never finishes a
 * request line cannot pin the accept loop (Slowloris).  Descriptor bounds are
 * checked before FD_SET/select so a stale or out-of-range listener cannot
 * write past the fd_set.
 */
#ifndef CPLUS_STD_WEB_HP
#define CPLUS_STD_WEB_HP

#include <errno.h>
#include <signal.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <sys/socket.h>
#include <sys/select.h>
#include <sys/time.h>
#include <arpa/inet.h>
#include <netinet/in.h>
#include <unistd.h>
#include "cplus/cplus.h"

#define WEB_MAX_PATH 256
#define WEB_MAX_BODY 512
#define WEB_NAP_MS 50
#define WEB_REQ_LINE_MAX 200

/* The reply header buffer is deliberately fixed (heap-free path).  Tests may
 * define a smaller value before including this header to exercise the
 * snprintf-truncation path; production uses 128 bytes. */
#ifndef WEB_REPLY_HEAD_MAX
#define WEB_REPLY_HEAD_MAX 128
#endif

typedef struct {
    char method[16];
    char path[WEB_MAX_PATH];
    char body[WEB_MAX_BODY];
    size_t body_len;
} web_request;

typedef struct {
    int listen_fd;
    int nap_ms;
} web_server;

typedef struct {
    int fd;
    web_request req;
} web_conn;

/* Normalize a caller-supplied timeout: non-positive values use the default. */
static int web_timeout_ms(int nap_ms) {
    return nap_ms > 0 ? nap_ms : WEB_NAP_MS;
}

/* A peer that resets or closes mid-reply must never kill the process with
 * SIGPIPE.  Linux offers MSG_NOSIGNAL per send; BSD/macOS offer the per-socket
 * SO_NOSIGPIPE option (inherited by accepted sockets).  Both are thread-safe
 * and let send() return EPIPE as an ordinary I/O error.  We also apply the
 * socket option at send time so a caller-borrowed descriptor is protected. */
static void web_suppress_sigpipe(int fd) {
#ifdef SO_NOSIGPIPE
    int one = 1;
    if (fd >= 0)
        (void)setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
#else
    (void)fd;
#endif
}

static int web_send_flags(void) {
#ifdef MSG_NOSIGNAL
    return MSG_NOSIGNAL;
#else
    return 0;
#endif
}

/* Fallback for a POSIX platform with neither per-call nor per-socket
 * suppression: ignore SIGPIPE only for the duration of the send loop, then
 * restore the exact previous disposition (including a caller's handler). */
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
typedef struct {
    struct sigaction previous;
    int installed;
} web_sigpipe_scope;

static void web_sigpipe_scope_enter(web_sigpipe_scope *scope) {
    struct sigaction ignore;
    scope->installed = 0;
    memset(&ignore, 0, sizeof(ignore));
    ignore.sa_handler = SIG_IGN;
    sigemptyset(&ignore.sa_mask);
    if (sigaction(SIGPIPE, &ignore, &scope->previous) == 0)
        scope->installed = 1;
}

static void web_sigpipe_scope_leave(web_sigpipe_scope *scope) {
    if (scope->installed)
        (void)sigaction(SIGPIPE, &scope->previous, (struct sigaction *)0);
}
#endif

/* Convert milliseconds to a timeval, guarding overflow of tv_usec. */
static struct timeval web_timeval_ms(int ms) {
    struct timeval tv;
    int t = web_timeout_ms(ms);
    tv.tv_sec = t / 1000;
    tv.tv_usec = (suseconds_t)((t % 1000) * 1000);
    return tv;
}

/* Wait (at most timeout_ms) for fd to be readable, then read up to cap bytes.
 * Returns the byte count (>0), or 0 on timeout, EOF, error or invalid fd.
 * select() modifies its arguments, so both set and tv are rebuilt on EINTR. */
static ssize_t web_recv_bounded(int fd, char *buf, size_t cap, int timeout_ms) {
    fd_set set;
    struct timeval tv;
    int ready;
    ssize_t got;
    if (fd < 0 || fd >= FD_SETSIZE || buf == (char *)0 || cap == 0)
        return 0;
    for (;;) {
        FD_ZERO(&set);
        FD_SET(fd, &set);
        tv = web_timeval_ms(timeout_ms);
        ready = select(fd + 1, &set, (fd_set *)0, (fd_set *)0, &tv);
        if (ready >= 0 || errno != EINTR)
            break;
    }
    if (ready <= 0)
        return 0;
    do {
        got = recv(fd, buf, cap, 0);
    } while (got < 0 && errno == EINTR);
    return got > 0 ? got : 0;
}

/* Send every byte, retrying EINTR and absorbing short writes.  Returns 0 on
 * success, -1 on a peer error/no-progress (the caller stops writing). */
static int web_send_all(int fd, const char *buf, size_t len) {
    size_t sent = 0;
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
    web_sigpipe_scope sigpipe_scope;
#endif
    if (fd < 0 || (buf == (const char *)0 && len > 0))
        return -1;
    web_suppress_sigpipe(fd);
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
    web_sigpipe_scope_enter(&sigpipe_scope);
#endif
    while (sent < len) {
        /* MSG_NOSIGNAL on Linux, SO_NOSIGPIPE on BSD/macOS: a dead peer is an
         * EPIPE return, never a process-killing signal. */
        ssize_t n = send(fd, buf + sent, len - sent, web_send_flags());
        if (n > 0) {
            sent += (size_t)n;
            continue;
        }
        if (n < 0 && errno == EINTR)
            continue;
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
        web_sigpipe_scope_leave(&sigpipe_scope);
#endif
        return -1;                 /* closed peer, reset, or no progress */
    }
#if !defined(MSG_NOSIGNAL) && !defined(SO_NOSIGPIPE)
    web_sigpipe_scope_leave(&sigpipe_scope);
#endif
    return 0;
}

/* Initialize a caller-owned web_server (stack or static storage) on host:port.
 * Returns 0 on success, -1 on failure. No heap allocation: this is the
 * heap-free path used by the app; the *_start wrapper below is the malloc
 * convenience variant for existing callers. */
static int web_server_init(web_server *s, const char *host, int port) {
    struct sockaddr_in addr;
    int one = 1;
    int fd;
    if (s == (web_server *)0)
        return -1;
    s->listen_fd = -1;
    s->nap_ms = WEB_NAP_MS;
    fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0)
        return -1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
    web_suppress_sigpipe(fd);
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons((uint16_t)port);
    addr.sin_addr.s_addr =
        (host == (const char *)0) ? INADDR_ANY : inet_addr(host);
    if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) != 0 || listen(fd, 8) != 0) {
        close(fd);
        return -1;
    }
    s->listen_fd = fd;
    return 0;
}

/* Malloc convenience wrapper; prefer web_server_init() for a stack server. */
static web_server *web_server_start(const char *host, int port) {
    web_server *s = (web_server *)malloc(sizeof(web_server));
    if (s == (web_server *)0)
        return (web_server *)0;
    if (web_server_init(s, host, port) != 0) {
        free(s);
        return (web_server *)0;
    }
    return s;
}

/* Accept one connection; returns 1 with *c filled, 0 on no-pending (timeout),
 * -1 on terminal error.  The request line is read under a total time budget
 * so a peer that stalls mid-request cannot block the accept loop. */
static int web_accept(web_server *s, web_conn *c) {
    struct timeval tv;
    struct timeval started;
    struct timeval now;
    fd_set set;
    int fd;
    int ready;
    int budget_ms;
    long elapsed;
    char line[WEB_REQ_LINE_MAX];
    size_t used = 0;
    if (s == (web_server *)0 || c == (web_conn *)0)
        return -1;
    c->fd = -1;
    c->req.body_len = 0;
    c->req.method[0] = 0;
    c->req.path[0] = 0;
    /* An invalid or out-of-range descriptor must never reach FD_SET/select:
     * FD_SET would write past the fd_set for fd >= FD_SETSIZE. */
    if (s->listen_fd < 0 || s->listen_fd >= FD_SETSIZE)
        return -1;
    for (;;) {
        FD_ZERO(&set);
        FD_SET(s->listen_fd, &set);
        tv = web_timeval_ms(s->nap_ms);
        ready = select(s->listen_fd + 1, &set, (fd_set *)0, (fd_set *)0, &tv);
        if (ready >= 0 || errno != EINTR)
            break;
    }
    if (ready <= 0)
        return 0;
    fd = accept(s->listen_fd, (struct sockaddr *)0, (socklen_t *)0);
    if (fd < 0)
        return 0;
    c->fd = fd;
    /* Belt and braces: cap any later recv() even if select races with it. */
    web_suppress_sigpipe(fd);
    tv = web_timeval_ms(s->nap_ms);
    (void)setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));

    /* Whole request line gets a small fixed budget (a few nap intervals),
     * not one unbounded recv() per byte. */
    budget_ms = web_timeout_ms(s->nap_ms) * 4;
    if (budget_ms < WEB_NAP_MS * 4)
        budget_ms = WEB_NAP_MS * 4;
    gettimeofday(&started, (struct timezone *)0);
    while (used < WEB_REQ_LINE_MAX - 1) {
        ssize_t got;
        char *chunk;
        char *nl;
        size_t cap = WEB_REQ_LINE_MAX - 1 - used;
        gettimeofday(&now, (struct timezone *)0);
        elapsed = (long)(now.tv_sec - started.tv_sec) * 1000L +
                  (long)(now.tv_usec - started.tv_usec) / 1000L;
        if (elapsed >= (long)budget_ms)
            break;
        chunk = line + used;
        got = web_recv_bounded(fd, chunk, cap, (int)((long)budget_ms - elapsed));
        if (got <= 0)
            break;                 /* timeout/EOF/peer stalled: never hang */
        nl = (char *)memchr(chunk, '\n', (size_t)got);
        if (nl != (char *)0) {
            size_t take = (size_t)(nl - chunk) + 1;
            used += take < cap ? take : cap;
            break;
        }
        used += (size_t)got;
    }
    line[used] = 0;
    {
        /* METHOD SP PATH SP HTTP/x.y */
        char *sp1 = strchr(line, ' ');
        char *sp2 = sp1 ? strchr(sp1 + 1, ' ') : (char *)0;
        if (sp1 != (char *)0 && sp2 != (char *)0) {
            size_t mlen = (size_t)(sp1 - line) < 15 ? (size_t)(sp1 - line) : 15;
            size_t plen = (size_t)(sp2 - sp1 - 1) < WEB_MAX_PATH - 1
                              ? (size_t)(sp2 - sp1 - 1) : WEB_MAX_PATH - 1;
            memcpy(c->req.method, line, mlen);
            c->req.method[mlen] = 0;
            memcpy(c->req.path, sp1 + 1, plen);
            c->req.path[plen] = 0;
        }
    }
    return 1;
}

/* Write a reply: "HTTP/1.1 <status>\r\nContent-Length: N\r\n\r\n<body>".
 * Null arguments are inert; a truncated header is sent as its valid prefix
 * and partial sends are retried until all bytes are out. */
static void web_reply(web_conn *c, int status, const char *body) {
    char head[WEB_REPLY_HEAD_MAX];
    const char *text;
    size_t len;
    int hlen;
    size_t hsend;
    if (c == (web_conn *)0 || c->fd < 0)
        return;
    if (body == (const char *)0)
        body = "";
    len = strlen(body);
    switch (status) {
        case 200: text = "OK"; break;
        case 404: text = "Not Found"; break;
        default:  text = "Status"; break;
    }
    hlen = snprintf(head, sizeof(head),
                    "HTTP/1.1 %d %s\r\nContent-Length: %zu\r\nConnection: close\r\n\r\n",
                    status, text, len);
    if (hlen < 0)
        return;
    /* snprintf can report the would-be length: never send past the buffer. */
    hsend = (size_t)hlen < sizeof(head) ? (size_t)hlen : sizeof(head) - 1;
    if (web_send_all(c->fd, head, hsend) != 0)
        return;                    /* peer gone: do not push the body */
    (void)web_send_all(c->fd, body, len);
}

/* Close a connection: write-shutdown, settle briefly so the reply reaches
 * the client, then close. */
static void web_conn_close(web_conn *c) {
    if (c != (web_conn *)0 && c->fd >= 0) {
        shutdown(c->fd, SHUT_WR);
        usleep(10000);              /* let the reply bytes reach the peer */
        close(c->fd);
    }
    if (c != (web_conn *)0)
        c->fd = -1;
}

/* Stop the listening server. */
/* Close a caller-owned server without releasing its storage. */
static void web_server_shutdown(web_server *s) {
    if (s != (web_server *)0 && s->listen_fd >= 0) {
        close(s->listen_fd);
        s->listen_fd = -1;
    }
}

/* Close and release a web_server returned by web_server_start(). */
static void web_server_stop(web_server *s) {
    if (s != (web_server *)0) {
        web_server_shutdown(s);
        free(s);
    }
}

#endif /* CPLUS_STD_WEB_HP */
