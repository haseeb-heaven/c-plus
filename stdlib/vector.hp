/* C+ standard library: growable int vector with a tracked size.
 *
 * Storage comes from the C+ managed allocator (cplus_alloc / cplus_release);
 * there is no second allocator here.  Growth is overflow-checked and every
 * mutation that can fail reports it through its return value.
 */
#ifndef CPLUS_STD_VECTOR_HP
#define CPLUS_STD_VECTOR_HP

#include "cplus/cplus.h"

/* Borrowed, bounds-checked window over ints.  It never owns storage and is
 * invalidated by the owner's growth or destruction. */
class slice {
    int *items;
    size_t count;

    slice(int *items, size_t count) {
        this->items = items;
        this->count = count;
    }

    size_t size(void) {
        return this->count;
    }

    int valid(void) {
        return this->items != NULL && this->count > 0;
    }

    /* 0 on success, -1 when the index is outside the slice. */
    int at_checked(size_t index, int *out) {
        if (out == NULL)
            return -1;
        if (this->items == NULL || index >= this->count)
            return -1;
        *out = this->items[index];
        return 0;
    }

    /* Sub-slice [start, start+n) clamped to the extent; empty when start is
     * outside the slice. */
    slice sub(size_t start, size_t length) {
        slice empty = slice(NULL, 0);
        size_t available;
        if (this->items == NULL || start >= this->count)
            return empty;
        available = this->count - start;
        if (length > available)
            length = available;
        {
            slice part = slice(this->items + start, length);
            return part;
        }
    }
};

class vector {
    int *items;
    size_t used;
    size_t space;

    vector(void) {
        this->items = NULL;
        this->used = 0;
        this->space = 0;
    }

    size_t size(void) {
        return this->used;
    }

    size_t capacity(void) {
        return this->space;
    }

    /* Grow the buffer to hold at least `want` elements.  0 on success. */
    int reserve(size_t want) {
        int *fresh;
        size_t i;
        if (want <= this->space)
            return 0;
        if (want > SIZE_MAX / sizeof(int))
            return -1;
        fresh = (int *)cplus_alloc(sizeof(int) * want);
        for (i = 0; i < this->used; i++)
            fresh[i] = this->items[i];
        if (this->items != NULL)
            cplus_release(this->items);
        this->items = fresh;
        this->space = want;
        return 0;
    }

    int push_back(int value) {
        if (this->used == this->space) {
            size_t want = 4;
            if (this->space > 0) {
                if (this->space > (SIZE_MAX / 2) / sizeof(int))
                    return -1;
                want = this->space * 2;
            }
            if (vector_reserve(this, want) != 0)
                return -1;
        }
        this->items[this->used++] = value;
        return 0;
    }

    /* Compatibility accessor: returns 0 for an out-of-range index. */
    int at(size_t index) {
        if (index >= this->used)
            return 0;
        return this->items[index];
    }

    /* Checked access: 0 on success, -1 when the index is out of range. */
    int at_checked(size_t index, int *out) {
        if (out == NULL)
            return -1;
        if (index >= this->used)
            return -1;
        *out = this->items[index];
        return 0;
    }

    /* Remove the last element into out: 0 on success, -1 when empty. */
    int pop_back(int *out) {
        if (out == NULL)
            return -1;
        if (this->used == 0)
            return -1;
        *out = this->items[this->used - 1];
        this->used--;
        return 0;
    }

    void clear(void) {
        this->used = 0;
    }

    /* Borrowed view of the current contents. */
    slice view(void) {
        slice borrowed = slice(this->items, this->used);
        return borrowed;
    }

    void drop(void) {
        if (this->items != NULL) {
            cplus_release(this->items);
            this->items = NULL;
            this->used = 0;
            this->space = 0;
        }
    }
};

#endif
