/* C+ standard library: associative collections.
 *
 * Two small, auditable hash maps over the C+ allocator: int keys (`intmap`) and
 * owned string keys (`strmap`).  Open addressing with linear probing and
 * tombstones; growth is overflow-checked and rehashes in place.  No new
 * allocator, no hidden GC: drop() releases everything exactly once.
 */
#ifndef CPLUS_STD_COLLECTIONS_HP
#define CPLUS_STD_COLLECTIONS_HP

#include <string.h>
#include "cplus/cplus.h"

#define MAP_EMPTY 0
#define MAP_FULL 1
#define MAP_DELETED 2

static inline unsigned long long map_hash_int(long long key) {
    unsigned long long x = (unsigned long long)key;
    x ^= x >> 33;
    x *= 0xff51afd7ed558ccdULL;
    x ^= x >> 33;
    x *= 0xc4ceb9fe1a85ec53ULL;
    x ^= x >> 33;
    return x;
}

static inline unsigned long long map_hash_text(const char *text) {
    unsigned long long hash = 1469598103934665603ULL;
    while (text != NULL && *text != '\0') {
        hash ^= (unsigned char)*text++;
        hash *= 1099511628211ULL;
    }
    return hash;
}

/* ---- int -> int --------------------------------------------------------- */

class intmap {
    int *keys;
    int *values;
    unsigned char *state;
    size_t capacity;
    size_t count;
    size_t used_slots;

    intmap(void) {
        this->keys = NULL;
        this->values = NULL;
        this->state = NULL;
        this->capacity = 0;
        this->count = 0;
        this->used_slots = 0;
    }

    size_t size(void) {
        return this->count;
    }

    int valid(void) {
        return this->state != NULL;
    }

    /* Rebuild into a larger table; 0 on success. */
    int grow(size_t want) {
        int *fresh_keys;
        int *fresh_values;
        unsigned char *fresh_state;
        size_t i;
        if (want < 8)
            want = 8;
        if (want > SIZE_MAX / sizeof(int) / 2 ||
            want > SIZE_MAX / sizeof(unsigned char))
            return -1;
        fresh_keys = (int *)cplus_alloc(sizeof(int) * want);
        fresh_values = (int *)cplus_alloc(sizeof(int) * want);
        fresh_state = (unsigned char *)cplus_alloc(sizeof(unsigned char) * want);
        memset(fresh_state, MAP_EMPTY, sizeof(unsigned char) * want);
        for (i = 0; i < this->capacity; i++) {
            if (this->state[i] == MAP_FULL) {
                size_t slot = (size_t)(map_hash_int(this->keys[i]) & (want - 1));
                while (fresh_state[slot] == MAP_FULL)
                    slot = (slot + 1) & (want - 1);
                fresh_keys[slot] = this->keys[i];
                fresh_values[slot] = this->values[i];
                fresh_state[slot] = MAP_FULL;
            }
        }
        if (this->keys != NULL)
            cplus_release(this->keys);
        if (this->values != NULL)
            cplus_release(this->values);
        if (this->state != NULL)
            cplus_release(this->state);
        this->keys = fresh_keys;
        this->values = fresh_values;
        this->state = fresh_state;
        this->capacity = want;
        this->used_slots = this->count;
        return 0;
    }

    int put(int key, int value) {
        size_t slot;
        size_t first_deleted = (size_t)-1;
        if (this->capacity == 0 ||
            (this->used_slots + 1) * 10 >= this->capacity * 7) {
            if (this->grow(this->capacity == 0 ? 8 : this->capacity * 2) != 0)
                return -1;
        }
        slot = (size_t)(map_hash_int(key) & (this->capacity - 1));
        for (;;) {
            if (this->state[slot] == MAP_FULL) {
                if (this->keys[slot] == key) {
                    this->values[slot] = value;
                    return 0;
                }
            } else if (this->state[slot] == MAP_EMPTY) {
                if (first_deleted != (size_t)-1)
                    slot = first_deleted;
                else
                    this->used_slots++;
                this->keys[slot] = key;
                this->values[slot] = value;
                this->state[slot] = MAP_FULL;
                this->count++;
                return 0;
            } else if (first_deleted == (size_t)-1) {
                first_deleted = slot;
            }
            slot = (slot + 1) & (this->capacity - 1);
        }
    }

    int get(int key, int *out) {
        size_t slot;
        int probes;
        if (!this->valid() || out == NULL)
            return -1;
        slot = (size_t)(map_hash_int(key) & (this->capacity - 1));
        for (probes = 0; probes < (int)this->capacity; probes++) {
            if (this->state[slot] == MAP_EMPTY)
                return -1;
            if (this->state[slot] == MAP_FULL && this->keys[slot] == key) {
                *out = this->values[slot];
                return 0;
            }
            slot = (slot + 1) & (this->capacity - 1);
        }
        return -1;
    }

    int contains(int key) {
        int value = 0;
        return this->get(key, &value) == 0;
    }

    int remove(int key) {
        size_t slot;
        int probes;
        if (!this->valid())
            return -1;
        slot = (size_t)(map_hash_int(key) & (this->capacity - 1));
        for (probes = 0; probes < (int)this->capacity; probes++) {
            if (this->state[slot] == MAP_EMPTY)
                return -1;
            if (this->state[slot] == MAP_FULL && this->keys[slot] == key) {
                this->state[slot] = MAP_DELETED;
                this->count--;
                return 0;
            }
            slot = (slot + 1) & (this->capacity - 1);
        }
        return -1;
    }

    void clear(void) {
        if (this->state != NULL)
            memset(this->state, MAP_EMPTY, sizeof(unsigned char) * this->capacity);
        this->count = 0;
        this->used_slots = 0;
    }

    void drop(void) {
        if (this->keys != NULL)
            cplus_release(this->keys);
        if (this->values != NULL)
            cplus_release(this->values);
        if (this->state != NULL)
            cplus_release(this->state);
        this->keys = NULL;
        this->values = NULL;
        this->state = NULL;
        this->capacity = 0;
        this->count = 0;
        this->used_slots = 0;
    }
};

/* ---- string -> int, with owned keys ------------------------------------- */

class strmap {
    char **keys;
    int *values;
    unsigned char *state;
    size_t capacity;
    size_t count;
    size_t used_slots;

    strmap(void) {
        this->keys = NULL;
        this->values = NULL;
        this->state = NULL;
        this->capacity = 0;
        this->count = 0;
        this->used_slots = 0;
    }

    size_t size(void) {
        return this->count;
    }

    int valid(void) {
        return this->state != NULL;
    }

    /* internal helper: `stdlib_` prefix keeps it out of the public coverage surface */
    char *stdlib_copy_key(const char *text) {
        size_t n = strlen(text) + 1;
        char *copy = (char *)cplus_alloc(n);
        memcpy(copy, text, n);
        return copy;
    }

    int grow(size_t want) {
        char **fresh_keys;
        int *fresh_values;
        unsigned char *fresh_state;
        size_t i;
        if (want < 8)
            want = 8;
        if (want > SIZE_MAX / sizeof(char *) / 2 ||
            want > SIZE_MAX / sizeof(int))
            return -1;
        fresh_keys = (char **)cplus_alloc(sizeof(char *) * want);
        fresh_values = (int *)cplus_alloc(sizeof(int) * want);
        fresh_state = (unsigned char *)cplus_alloc(sizeof(unsigned char) * want);
        memset(fresh_state, MAP_EMPTY, sizeof(unsigned char) * want);
        for (i = 0; i < this->capacity; i++) {
            if (this->state[i] == MAP_FULL) {
                size_t slot =
                    (size_t)(map_hash_text(this->keys[i]) & (want - 1));
                while (fresh_state[slot] == MAP_FULL)
                    slot = (slot + 1) & (want - 1);
                fresh_keys[slot] = this->keys[i];
                fresh_values[slot] = this->values[i];
                fresh_state[slot] = MAP_FULL;
            } else if (this->state[i] == MAP_DELETED && this->keys[i] != NULL) {
                cplus_release(this->keys[i]);
            }
        }
        if (this->keys != NULL)
            cplus_release(this->keys);
        if (this->values != NULL)
            cplus_release(this->values);
        if (this->state != NULL)
            cplus_release(this->state);
        this->keys = fresh_keys;
        this->values = fresh_values;
        this->state = fresh_state;
        this->capacity = want;
        this->used_slots = this->count;
        return 0;
    }

    int put(const char *key, int value) {
        size_t slot;
        size_t first_deleted = (size_t)-1;
        if (key == NULL)
            return -1;
        if (this->capacity == 0 ||
            (this->used_slots + 1) * 10 >= this->capacity * 7) {
            if (this->grow(this->capacity == 0 ? 8 : this->capacity * 2) != 0)
                return -1;
        }
        slot = (size_t)(map_hash_text(key) & (this->capacity - 1));
        for (;;) {
            if (this->state[slot] == MAP_FULL) {
                if (strcmp(this->keys[slot], key) == 0) {
                    this->values[slot] = value;
                    return 0;
                }
            } else if (this->state[slot] == MAP_EMPTY) {
                size_t target = first_deleted != (size_t)-1 ? first_deleted : slot;
                if (first_deleted == (size_t)-1)
                    this->used_slots++;
                this->keys[target] = this->stdlib_copy_key(key);
                this->values[target] = value;
                this->state[target] = MAP_FULL;
                this->count++;
                return 0;
            } else if (first_deleted == (size_t)-1) {
                first_deleted = slot;
            }
            slot = (slot + 1) & (this->capacity - 1);
        }
    }

    int get(const char *key, int *out) {
        size_t slot;
        int probes;
        if (!this->valid() || key == NULL || out == NULL)
            return -1;
        slot = (size_t)(map_hash_text(key) & (this->capacity - 1));
        for (probes = 0; probes < (int)this->capacity; probes++) {
            if (this->state[slot] == MAP_EMPTY)
                return -1;
            if (this->state[slot] == MAP_FULL &&
                strcmp(this->keys[slot], key) == 0) {
                *out = this->values[slot];
                return 0;
            }
            slot = (slot + 1) & (this->capacity - 1);
        }
        return -1;
    }

    int contains(const char *key) {
        int value = 0;
        return this->get(key, &value) == 0;
    }

    int remove(const char *key) {
        size_t slot;
        int probes;
        if (!this->valid() || key == NULL)
            return -1;
        slot = (size_t)(map_hash_text(key) & (this->capacity - 1));
        for (probes = 0; probes < (int)this->capacity; probes++) {
            if (this->state[slot] == MAP_EMPTY)
                return -1;
            if (this->state[slot] == MAP_FULL &&
                strcmp(this->keys[slot], key) == 0) {
                if (this->keys[slot] != NULL) {
                    cplus_release(this->keys[slot]);
                    this->keys[slot] = NULL;
                }
                this->state[slot] = MAP_DELETED;
                this->count--;
                return 0;
            }
            slot = (slot + 1) & (this->capacity - 1);
        }
        return -1;
    }

    void clear(void) {
        size_t i;
        for (i = 0; i < this->capacity; i++) {
            if (this->state[i] == MAP_FULL && this->keys[i] != NULL) {
                cplus_release(this->keys[i]);
                this->keys[i] = NULL;
            }
            this->state[i] = MAP_EMPTY;
        }
        this->count = 0;
        this->used_slots = 0;
    }

    void drop(void) {
        this->clear();
        if (this->keys != NULL)
            cplus_release(this->keys);
        if (this->values != NULL)
            cplus_release(this->values);
        if (this->state != NULL)
            cplus_release(this->state);
        this->keys = NULL;
        this->values = NULL;
        this->state = NULL;
        this->capacity = 0;
    }
};

#endif
